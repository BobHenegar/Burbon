@model ProjectMoonshine.EntityFramework.Models.Phone

@{
    ViewData["Title"] = "Create";
}

<h2>Create</h2>

<h4>Phone</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if ((bool)ViewBag.AdrPerKeyHasValue)
            {
                <div class="form-group">
                    <label asp-for="PhoPerKey" class="control-label"></label>
                    <select asp-for="PhoPerKey" class="form-control" asp-items="ViewBag.PhoPerKey" readonly="true"></select>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label asp-for="PhoPerKey" class="control-label"></label>
                    <select asp-for="PhoPerKey" class="form-control" asp-items="ViewBag.AdrPerKey"></select>
                </div>
            }
            <div class="form-group">
                <label asp-for="PhoNumber" class="control-label"></label>
                <input asp-for="PhoNumber" class="form-control" />
                <span asp-validation-for="PhoNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhoExtention" class="control-label"></label>
                <input asp-for="PhoExtention" class="form-control" />
                <span asp-validation-for="PhoExtention" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="PhoIsPrimary" /> @Html.DisplayNameFor(model => model.PhoIsPrimary)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="PhoIsHome" /> @Html.DisplayNameFor(model => model.PhoIsHome)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="PhoIsMobile" /> @Html.DisplayNameFor(model => model.PhoIsMobile)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="PhoIsWork" /> @Html.DisplayNameFor(model => model.PhoIsWork)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
