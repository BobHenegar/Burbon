@model IEnumerable<ProjectMoonshine.EntityFramework.Models.Phone>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PhoPerKey)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoExtention)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoPrimary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoAddDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoModifiedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoAddUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoModifiedUser)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PhoPerKey)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhoNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhoExtention)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhoPrimary)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhoAddDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhoModifiedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhoAddUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhoModifiedUser)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PhoKey">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.PhoKey">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.PhoKey">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
