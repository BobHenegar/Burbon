@model ProjectMoonshine.EntityFramework.Models.Phone

@{
    ViewData["Title"] = "Edit";
}

<h2>Edit</h2>

<h4>Phone</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PhoKey" />
            <div class="form-group">
                <label asp-for="PhoNumber" class="control-label"></label>
                <input asp-for="PhoNumber" class="form-control" />
                <span asp-validation-for="PhoNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhoExtention" class="control-label"></label>
                <input asp-for="PhoExtention" class="form-control" />
                <span asp-validation-for="PhoExtention" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="PhoPrimary" /> @Html.DisplayNameFor(model => model.PhoPrimary)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="PhoAddDate" class="control-label"></label>
                <input asp-for="PhoAddDate" class="form-control" />
                <span asp-validation-for="PhoAddDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhoAddUser" class="control-label"></label>
                <input asp-for="PhoAddUser" class="form-control" />
                <span asp-validation-for="PhoAddUser" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhoModifiedUser" class="control-label"></label>
                <input asp-for="PhoModifiedUser" class="form-control" />
                <span asp-validation-for="PhoModifiedUser" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
