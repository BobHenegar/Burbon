@model IEnumerable<ProjectMoonshine.EntityFramework.Models.Degree>
<hr/>
<h4>Degrees</h4>
<a asp-controller="Degrees" asp-action="Create" asp-route-customerKey="@ViewBag.customerKey" asp-route-requirementKey="@ViewBag.requirementKey" >Add Degree</a>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DegreeType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DegInstitution)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.DegDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DegreeType.DetCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DegInstitution)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DegDate)
            </td>
            <td>
                <a asp-controller="Degrees" asp-action="Edit" asp-route-customerKey="@item.DegCusKey" asp-route-requirementKey="@ViewBag.requirementKey">Edit</a>
            </td>
        </tr>
}
    </tbody>
</table>
