@model IEnumerable<ProjectMoonshine.EntityFramework.Models.ExamScore>

<div>
    <h4>
        Exam Scores
    </h4>
    <p>
        <a asp-controller="ExamScores" asp-action="Create" asp-route-customerKey="@ViewBag.customerKey" asp-route-requirementKey="@ViewBag.requirementKey">Create New</a>
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Exam)
                </th>

                <th>
                    @Html.DisplayNameFor(model => model.ExsDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ExsTotalPossible)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ExsTotalReceived)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ExsSuccessFlag)
                </th>

                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Exam.ExmName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ExsDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ExsTotalPossible)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ExsTotalReceived)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ExsSuccessFlag)
                    </td>
                    <td><a asp-controller="ExamScores" asp-action="Edit" asp-route-id="@item.ExsKey" asp-route-requirementKey="@ViewBag.requirementKey" asp-route-customerKey="@item.ExsCusKey">Edit</a> |</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<hr/>

