@model ProjectMoonshine.EntityFramework.Models.CredentialRequirement
<h4>CEPeriod</h4>
<div class="row">
    
    <div class="col-lg-4" style="padding-bottom: 30px">
        <div style="width: 300px">
            <canvas id="cePeriodChart" width="400" height="400"></canvas>
        </div>
    </div>
    <div class="col-lg-8">
        <dl class="dl-horizontal">
            <dt>
                @Html.DisplayNameFor(model => model.CEPeriod.Ce2StartDate)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.CEPeriod.Ce2StartDate)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.CEPeriod.Ce2EndDate)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.CEPeriod.Ce2EndDate)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.CEPeriod.Ce2RequiredUnits)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.CEPeriod.Ce2RequiredUnits)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.CEPeriod.Ce2ReportedUnits)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.CEPeriod.Ce2ReportedUnits)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.CEPeriod.Ce2AcceptedUnits)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.CEPeriod.Ce2AcceptedUnits)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.CEPeriod.Ce2BalanceUnits)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.CEPeriod.Ce2BalanceUnits)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.CEPeriod.CeType)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.CEPeriod.CeType.CetCode)
            </dd>
        </dl>
    </div>
    
    <hr/>

</div>
<div>
    @*<a asp-action="Edit" asp-route-id="@Model.CEPeriod.Ce2Key">Edit</a> |*@
    @*<a asp-action="Index">Back to List</a>*@
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.4.0/Chart.min.js"></script>
<script>var ceChart = document.getElementById("cePeriodChart");
    function buildCeChartData(totalReported, totalRemaining) {
        var charData = {
            labels: [
                "Reported",
                "Remaining"
            ]
            , datasets: [
                {
                    data: [ totalReported, totalRemaining ],
                    backgroundColor: ["#4BC0C0","#F9F9F9"],
                    hoverBackgroundColor: ["#4BC0C0", "#F9F9F9"]
                }
            ]
        }
        return charData;
    }

    var chartData = buildCeChartData(@Model.CEPeriod.Ce2ReportedUnits,
        @(Model.CEPeriod.Ce2RequiredUnits - @Model.CEPeriod.Ce2ReportedUnits));
    var chart1 = new Chart(ceChart,
        {
            type: "doughnut",
            data: chartData
            //options: options
        }); </script>
