@using ProjectMoonshine.EntityFramework.Utils
@using GlobalConstants = ProjectMoonshine.EntityFramework.GlobalConstants
@model ProjectMoonshine.ViewModels.CredentialRequirementViewModel

<div class="form-group">
    <label asp-for="CredentialRequirement.Cr3Ct3Key" class="control-label"></label>
    @Html.DropDownListFor(r => r.CredentialRequirement.Cr3Ct3Key, Model.Cr3Ct3KeySelectList, "", new { @class = "form-control" })

    <span asp-validation-for="CredentialRequirement.Cr3Ct3Key" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CredentialRequirement.Cr3Cr2Key" class="control-label"></label>
    @Html.DropDownListFor(r => r.CredentialRequirement.Cr3Cr2Key, Model.Cr3Cr2KeySelectList, "", new { @class = "form-control" })

    <span asp-validation-for="CredentialRequirement.Cr3Cr2Key" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CredentialRequirement.Cr3Ct6Key" class="control-label"></label>
    @Html.DropDownListFor(r => r.CredentialRequirement.Cr3Ct6Key, Model.Cr3Ct6KeySelectList, "", new { @class = "form-control" })

    <span asp-validation-for="CredentialRequirement.Cr3Ct6Key" class="text-danger"></span>
</div>
@if (CommonUtils.IsGuidValid(Model.CredentialRequirement.Cr3Cr2Key))
{
    switch (Model.CredentialRequirement.CredentialRequirementType.Template.Ct8Code)
    {
        case GlobalConstants.RequirementTemplateCode.None:
            break;
        case GlobalConstants.RequirementTemplateCode.Application:
            break;
        case GlobalConstants.RequirementTemplateCode.Attestment:
            break;
        case GlobalConstants.RequirementTemplateCode.Audit:
            break;
        case GlobalConstants.RequirementTemplateCode.CE:
            break;
        case GlobalConstants.RequirementTemplateCode.Checklist:
            break;
        case GlobalConstants.RequirementTemplateCode.Course:
            break;
        case GlobalConstants.RequirementTemplateCode.Custom:
            break;
        case GlobalConstants.RequirementTemplateCode.Degree:
            <div class="form-group">
                <label asp-for="CredentialRequirement.Cr3DegKey" class="control-label"></label>
                @Html.DropDownListFor(r => r.CredentialRequirement.Cr3DegKey, Model.Cr3DegKeySelectList, "", new { @class = "form-control" })

                <span asp-validation-for="CredentialRequirement.Cr3DegKey" class="text-danger"></span>
            </div>
            break;
        case GlobalConstants.RequirementTemplateCode.Designation:
            break;
        case GlobalConstants.RequirementTemplateCode.Disclosure:
            break;
        case GlobalConstants.RequirementTemplateCode.Document:
            <div class="form-group">
                <label asp-for="CredentialRequirement.Cr3FupKey" class="control-label"></label>
                @Html.DropDownListFor(r => r.CredentialRequirement.Cr3FupKey, Model.Cr3FupKeySelectList, "", new { @class = "form-control" })

                <span asp-validation-for="CredentialRequirement.Cr3FupKey" class="text-danger"></span>
            </div>
            break;
        case GlobalConstants.RequirementTemplateCode.DocumentRequest:
            break;
        case GlobalConstants.RequirementTemplateCode.Ethics:
            break;
        case GlobalConstants.RequirementTemplateCode.Event:
            break;
        case GlobalConstants.RequirementTemplateCode.Exam:
            <div class="form-group">
                <label asp-for="CredentialRequirement.Cr3ExsKey" class="control-label"></label>
                @Html.DropDownListFor(r => r.CredentialRequirement.Cr3ExsKey, Model.Cr3ExsSelectList, "", new { @class = "form-control" })

                <span asp-validation-for="CredentialRequirement.Cr3ExsKey" class="text-danger"></span>
            </div>
            break;
        case GlobalConstants.RequirementTemplateCode.Experience:
            break;
        case GlobalConstants.RequirementTemplateCode.Fee:
            break;
        case GlobalConstants.RequirementTemplateCode.License:
            <div class="form-group">
                <label asp-for="CredentialRequirement.Cr3IxlKey" class="control-label"></label>
                @Html.DropDownListFor(r => r.CredentialRequirement.Cr3IxlKey, Model.Cr3IxlKeySelectList, "", new { @class = "form-control" })

                <span asp-validation-for="CredentialRequirement.Cr3IxlKey" class="text-danger"></span>
            </div>
            break;
        case GlobalConstants.RequirementTemplateCode.Membership:
            break;
        case GlobalConstants.RequirementTemplateCode.Relationship:
            break;
        case GlobalConstants.RequirementTemplateCode.Signature:
            break;
        case GlobalConstants.RequirementTemplateCode.Simple:
            break;
        case GlobalConstants.RequirementTemplateCode.Sql:
            break;
        case GlobalConstants.RequirementTemplateCode.Switch:
            break;
        default:
            break;
    }
}

<div class="form-group">
    <label asp-for="CredentialRequirement.Cr3StartDate" class="control-label"></label>
    <input asp-for="CredentialRequirement.Cr3StartDate" class="form-control" type="date" />
    <span asp-validation-for="CredentialRequirement.Cr3StartDate" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CredentialRequirement.Cr3DueDate" class="control-label"></label>
    <input asp-for="CredentialRequirement.Cr3DueDate" class="form-control" type="date" />
    <span asp-validation-for="CredentialRequirement.Cr3DueDate" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CredentialRequirement.Cr3MetDate" class="control-label"></label>
    <input asp-for="CredentialRequirement.Cr3MetDate" class="form-control" type="date" />
    <span asp-validation-for="CredentialRequirement.Cr3MetDate" class="text-danger"></span>
</div>

