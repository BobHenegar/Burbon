@model IEnumerable<ProjectMoonshine.EntityFramework.Models.CEDetail>

<p>
    <a asp-controller="CEDetails" asp-action="Create" asp-route-customerKey="@ViewBag.customerKey" asp-route-requirementKey="@ViewBag.requirementKey">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Ce1ActivityDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ce1ActivityDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ce1Units)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ce1VerifiedFlag)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CeType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Ce1ActivityDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ce1ActivityDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ce1Units)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ce1VerifiedFlag)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CeType.CetCode)
            </td>
            <td>
                <a asp-controller="CEDetails" asp-action="Edit" asp-route-id="@item.Ce1Key" asp-route-requirementKey="@ViewBag.requirementKey" asp-route-customerKey="@item.Ce1CusKey" >Edit</a> |
                @*<a asp-action="Details" asp-route-id="@item.Ce1Key">Details</a> |*@
                <a asp-controller="CEDetails" asp-action="Delete" asp-route-id="@item.Ce1Key" asp-route-requirementKey="@ViewBag.requirementKey" asp-route-customerKey="@item.Ce1CusKey" >Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
