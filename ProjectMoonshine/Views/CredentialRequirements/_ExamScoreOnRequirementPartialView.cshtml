@using ProjectMoonshine.EntityFramework.Utils
@model ProjectMoonshine.EntityFramework.Models.CredentialRequirement

<div>
    <h4>ExamScore</h4>
    
    @if (!Model.Cr3ExsKey.IsGuidValid())
    {
        <a asp-controller="ExamScores" asp-action="Create" asp-route-requirementKey="@Model.Cr3Key" asp-route-customerKey="@ViewBag.requirementKey" class="btn btn-primary">Add Exam Score</a>
    }
    else
    {
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.ExamScore.Exam)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ExamScore.Exam.ExmName)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.ExamScore.ExsDate)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ExamScore.ExsDate)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.ExamScore.ExsTotalPossible)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ExamScore.ExsTotalPossible)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.ExamScore.ExsTotalReceived)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ExamScore.ExsTotalReceived)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.ExamScore.ExsSuccessFlag)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ExamScore.ExsSuccessFlag)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.ExamScore.ExsAddDate)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ExamScore.ExsAddDate)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.ExamScore.ExsChangeDate)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ExamScore.ExsChangeDate)
        </dd>

    </dl>
    <a asp-controller="ExamScores" asp-action="Edit" asp-route-id="@Model.ExamScore.ExsKey" asp-route-requirementKey="@Model.Cr3Key" asp-route-customerKey="@ViewBag.customerKey" class="btn btn-primary">Edit Exam Score</a>
    }

</div>
