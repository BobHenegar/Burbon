@using ProjectMoonshine.EntityFramework.Utils
@model ProjectMoonshine.EntityFramework.Models.CredentialRequirement

<div>
    
    <h4>Current Degree</h4>
    
    @if (!Model.Cr3DegKey.IsGuidValid())
    {
    <a asp-controller="Degrees" asp-action="Create" asp-route-customerKey="@Model.CredentialProcess.Credential.Cr1CusKey"  asp-route-requirementKey="@Model.Cr3Key" class="btn btn-primary">Add Degree</a>
    }
    else
    {
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Degree.DegInstitution)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Degree.DegInstitution)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Degree.DegDate)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Degree.DegDate)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Degree.DegAddDate)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Degree.DegAddDate)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Degree.DegChangeDate)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Degree.DegChangeDate)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Degree.DegreeType)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Degree.DegreeType.DetCode)
        </dd>
    </dl>
        <a asp-controller="Degrees" asp-action="Edit" asp-route-id="@Model.Degree.DegKey" asp-route-requirementKey="@Model.Degree.DegCusKey" class="btn btn-primary">Edit Degree</a>
        @*<a asp-controller="Degrees" asp-action="Create" asp-route-customerKey="@Model.CredentialProcess.Credential.Cr1CusKey"  asp-route-requirementKey="@Model.Cr3Key" class="btn btn-primary">Add New Degree</a>*@
    }

</div>
