@model ProjectMoonshine.ViewModels.CredentialRequirementViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit</h2>

<h4>CredentialRequirement</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CredentialRequirement.Cr3Key" />
            @await Html.PartialAsync("_CredentialRequirementAddEditPartialView", Model)
            <div class="form-group">
                @{
                    if (Context.Request.Headers["Referer"].ToString().Contains("Credentials"))
                    {
                        <input type="hidden" name="source" id="source" value="certDetails"/>
                    }
                    else
                    {
                        <input type="hidden" name="source" id="source" value="" />
                    }
                }
                <input type="submit" value="Save" class="btn btn-default"/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
