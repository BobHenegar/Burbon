@model ProjectMoonshine.EntityFramework.Models.Degree


<div class="form-group">
    <label asp-for="DegCusKey" class="control-label"></label>
    <select asp-for="DegCusKey" class="form-control" asp-items="ViewBag.DegCusKey"></select>
    <span asp-validation-for="DegCusKey" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="DegInstitution" class="control-label"></label>
    <input asp-for="DegInstitution" class="form-control"/>
    <span asp-validation-for="DegInstitution" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="DegDate" class="control-label"></label>
    <input asp-for="DegDate" class="form-control" type="date"/>
    <span asp-validation-for="DegDate" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="DegDetKey" class="control-label"></label>
    <select asp-for="DegDetKey" class="form-control" asp-items="ViewBag.DegDetKey"></select>
    <span asp-validation-for="DegDetKey" class="text-danger"></span>
</div>
@(await Html.PartialAsync("_RequirementDataRedirectSourcePartialView"))