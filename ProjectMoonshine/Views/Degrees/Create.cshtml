@model ProjectMoonshine.EntityFramework.Models.Degree

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Create</h2>

<h4>Degree</h4>
<hr />
<div class="row">
    <div class="col-md-4">
