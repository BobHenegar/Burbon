@model ProjectMoonshine.EntityFramework.Models.EventRegistration

@{
    ViewData["Title"] = "Create";
}
<h2>Create</h2>

<h4>Event Registration</h4>
<hr />
<div class="container">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label asp-for="EvrEvtKey" class="control-label"></label>
            <div class="form-group">
                <select asp-for="EvrEvtKey" asp-items="ViewBag.EvrEvtKey" class="selectpicker show-tick" data-live-search="true" id="selectEvent">
                    <option data-hidden="true">Event:</option>
                </select>
                <span asp-validation-for="EvrEvtKey" class="text-danger"></span>
            </div>
            <label asp-for="EvrCusKey" class="control-label"></label>
            @if (ViewBag.CusKeyHasValue != null && (bool)ViewBag.CusKeyHasValue)
            {
                <div class="form-group">
                    <select asp-for="EvrCusKey" asp-items="ViewBag.EvrCusKey" class="selectpicker show-tick" data-live-search="true" id="selectCustomer" readonly="true"></select>
                </div>
            }
            else
            {
                <div class="form-group">
                    <select asp-for="EvrCusKey" asp-items="ViewBag.EvrCusKey" class="selectpicker show-tick" data-live-search="true" id="selectCustomer">
                        <option data-hidden="true">Customer:</option>
                    </select>
                </div>
            }
            <span asp-validation-for="EvrCusKey" class="text-danger"></span>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

