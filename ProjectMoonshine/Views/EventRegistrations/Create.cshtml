@model ProjectMoonshine.EntityFramework.Models.EventRegistration

@{
    ViewData["Title"] = "Create";
}

<h2>Create</h2>

<h4>EventRegistration</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="EvrEvtKey" class="control-label"></label>
                <select asp-for="EvrEvtKey" class="form-control" asp-items="ViewBag.EvrEvtKey"></select>
            </div>
            @if ((bool)ViewBag.CusKeyHasValue)
            {
                <div class="form-group">
                    <label asp-for="EvrCusKey" class="control-label"></label>
                    <select asp-for="EvrCusKey" class="form-control" asp-items="ViewBag.EvrCusKey" readonly="true"></select>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label asp-for="EvrCusKey" class="control-label"></label>
                    <select asp-for="EvrCusKey" class="form-control" asp-items="ViewBag.EvrCusKey"></select>
                </div>
            }
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
