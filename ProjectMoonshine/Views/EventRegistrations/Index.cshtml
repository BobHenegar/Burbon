@model IEnumerable<ProjectMoonshine.EntityFramework.Models.EventRegistration>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EvrDropDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EvrAddDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EvrChangeDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EvrAddUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EvrChangeUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Event)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Customer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RowVersion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.EvrDropDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EvrAddDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EvrChangeDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EvrAddUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EvrChangeUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Event.EvtDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.CusKey)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RowVersion)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EvrKey">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EvrKey">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.EvrKey">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
