@model ProjectMoonshine.EntityFramework.Models.Person

@{
    ViewData["Title"] = "Create";
}

<h2>Create</h2>

<h4>Person</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PerFirstName" class="control-label"></label>
                <input asp-for="PerFirstName" class="form-control" />
                <span asp-validation-for="PerFirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PerMiddleName" class="control-label"></label>
                <input asp-for="PerMiddleName" class="form-control" />
                <span asp-validation-for="PerMiddleName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PerLastName" class="control-label"></label>
                <input asp-for="PerLastName" class="form-control" />
                <span asp-validation-for="PerLastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PerDateOfBirth" class="control-label"></label>
                <div id="datepicker" class="input-group date" data-date-format="mm-dd-yyyy">
                    <input asp-for="PerDateOfBirth" class="form-control" type="text" readonly />
                    <span class="input-group-addon"><i class="glyphicon glyphicon-calendar"></i></span>
                </div>
                <span asp-validation-for="PerDateOfBirth" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PerGender" class="control-label"></label>
                @Html.RadioButtonFor(model => model.PerGender, "Female") <span>Female</span>
                @Html.RadioButtonFor(model => model.PerGender, "Male") <span>Male</span>
                <span asp-validation-for="PerGender" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script type="text/javascript">
        $(function () {
            $("#datepicker").datepicker({
                autoclose: true,
                todayHighlight: true
            }).datepicker('update', new Date());
        });
    </script>
}
