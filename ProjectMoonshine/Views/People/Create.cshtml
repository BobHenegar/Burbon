@model ProjectMoonshine.ViewModels.PersonViewModel

@{
    ViewData["Title"] = "Create";
}
<h3>Create</h3>
<hr />
<div>
    <form asp-action="Create">
        <div class="col-md-12">
            <div class="col-md-12">
                <h3>Personal Information:</h3>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="PerFirstName" class="control-label"></label>
                        <input asp-for="PerFirstName" class="form-control" />
                        <span asp-validation-for="PerFirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="PerMiddleName" class="control-label"></label>
                        <input asp-for="PerMiddleName" class="form-control" />
                        <span asp-validation-for="PerMiddleName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="PerLastName" class="control-label"></label>
                        <input asp-for="PerLastName" class="form-control" />
                        <span asp-validation-for="PerLastName" class="text-danger"></span>
                    </div>
                </div>
            </div> <!--PersonalInfo-->
            <div class="col-md-12">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PerDateOfBirth" class="control-label"></label>
                        <input asp-for="PerDateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="PerDateOfBirth" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label asp-for="PerGender" class="control-label"></label>
                        </div>
                        <div class="col-md-4">
                            <div class="col-md-12">
                                @Html.RadioButtonFor(model => model.PerGender, "Male") Male
                            </div>
                            <div class="col-md-12">
                                @Html.RadioButtonFor(model => model.PerGender, "Female") Female
                            </div>
                            <span asp-validation-for="PerGender" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div> <!--PersonalInfo-->
            <div class="col-md-12">
                <h3>Address Information:</h3>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="AdrAddress1" class="control-label"></label>
                        <input asp-for="AdrAddress1" class="form-control" />
                        <span asp-validation-for="AdrAddress1" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AdrAddress2" class="control-label"></label>
                        <input asp-for="AdrAddress2" class="form-control" />
                        <span asp-validation-for="AdrAddress2" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AdrAddress3" class="control-label"></label>
                        <input asp-for="AdrAddress3" class="form-control" />
                        <span asp-validation-for="AdrAddress3" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="AdrCity" class="control-label"></label>
                        <input asp-for="AdrCity" class="form-control" />
                        <span asp-validation-for="AdrCity" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AdrState" class="control-label"></label>
                        <input asp-for="AdrState" class="form-control" />
                        <span asp-validation-for="AdrState" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AdrZip" class="control-label"></label>
                        <input asp-for="AdrZip" class="form-control" />
                        <span asp-validation-for="AdrZip" class="text-danger"></span>
                    </div>
                </div>
            </div><!--Address Info-->
            <div class="col-md-12">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="AdrIsHome" class="control-label"></label>
                        @Html.CheckBoxFor(model => model.AdrIsHome)
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="AdrIsMailing" class="control-label"></label>
                        @Html.CheckBoxFor(model => model.AdrIsMailing, new { @checked = false })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="AdrIsWork" class="control-label"></label>
                        @Html.CheckBoxFor(model => model.AdrIsWork, new { @checked = false })
                    </div>
                </div>
            </div><!--Address Type Info-->
        </div>
        <div class="col-md-12">
            <div class="col-md-6">
                <h3>Email Information:</h3>
                <div class="form-group">
                    <label asp-for="EmlAddress" class="control-label"></label>
                    <input asp-for="EmlAddress" class="form-control" />
                    <span asp-validation-for="EmlAddress" class="text-danger"></span>
                </div>
                <div class="col-md-12">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="EmlIsPersonal" class="control-label"></label>
                            @Html.CheckBoxFor(model => model.EmlIsPersonal)
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="EmlIsWork" class="control-label"></label>
                            @Html.CheckBoxFor(model => model.EmlIsWork, new { @checked = false })
                        </div>
                    </div>
                </div>
            </div> <!--Email Info-->
            <div class="col-md-6">
                <h4>Phone Information:</h4>
                <div class="form-group">
                    <div class="form-group">
                        <label asp-for="PhoNumber" class="control-label"></label>
                        <input asp-for="PhoExtention" class="form-control" />
                        <span asp-validation-for="PhoExtention" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="PhoIsMobile" class="control-label"></label>
                            @Html.CheckBoxFor(model => model.PhoIsMobile)
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="PhoIsHome" class="control-label"></label>
                            @Html.CheckBoxFor(model => model.PhoIsHome)
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="PhoIsWork" class="control-label"></label>
                            @Html.CheckBoxFor(model => model.PhoIsWork, new { @checked = false })
                        </div>
                    </div>
                </div>
            </div> <!--Phone Info-->
        </div>
        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-default" />
        </div>
    </form>
</div>
<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
