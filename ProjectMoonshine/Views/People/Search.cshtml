@model ProjectMoonshine.ViewModels.PersonViewModel

@{
    ViewData["Title"] = "Create";
}
<h3>Search</h3>
<hr />
<div class="row">
<div class="col-lg-5">
    <form asp-action="Search">
        <div class="row">
            <div class="form-group">
                <div class="col-md-2">
                    <label class="control-label">And/Or</label>
                </div>
                <div class="col-md-2">
                    <select name="andor" id="andor"><option value="and" selected>And</option><option value="or">Or</option></select>
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-3">
                    <label class="control-label">Contains/Begins With</label>
                </div>
                <div class="col-md-2">
                    <select name="contains" id="contains"><option value="cont" selected>Contains</option><option value="begins">Begins With</option></select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <label asp-for="PerFirstName" class="control-label"></label>
                <input asp-for="PerFirstName" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="PerMiddleName" class="control-label"></label>
                <input asp-for="PerMiddleName" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="PerLastName" class="control-label"></label>
                <input asp-for="PerLastName" class="form-control" />
            </div>
            @*<div class="form-group">
                <label asp-for="AdrCity" class="control-label"></label>
                <input asp-for="AdrCity" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="AdrState" class="control-label"></label>
                <input asp-for="AdrState" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="AdrZip" class="control-label"></label>
                <input asp-for="AdrZip" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="EmlAddress" class="control-label"></label>
                <input asp-for="EmlAddress" class="form-control" />
            </div>*@
            <div class="form-group">
                <input type="submit" value="Search" class="btn btn-default" />
            </div>
        </div>
    </form>
</div>
</div>
<div>
    <a asp-action="Index">Back to List</a>
</div>

