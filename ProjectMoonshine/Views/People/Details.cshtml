@model ProjectMoonshine.EntityFramework.Models.Person

@{
    ViewData["Title"] = "Details";
}

<h2>Details</h2>

<div>
    <h4>Person</h4>
    <div style="width:100%;float:left;">
        <a asp-action="Edit" asp-route-id="@Model.PerKey">Edit Person</a> | <a asp-action="Index">Back to List</a>
    </div>
    <div style="width:100%; height:250px;border-top:1px solid #eee">
        <dl class="dl-horizontal">
            <dt>
                @Html.DisplayNameFor(model => model.PerFirstName)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.PerFirstName)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.PerMiddleName)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.PerMiddleName)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.PerLastName)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.PerLastName)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.PerDateOfBirth)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.PerDateOfBirth)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.PerGender)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.PerGender)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.PerAddDate)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.PerAddDate)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.PerChangeDate)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.PerChangeDate)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.PerAddUser)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.PerAddUser)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.PerChangeUser)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.PerChangeUser)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.Customer)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Customer.CusKey)
            </dd>
        </dl>
    </div>
    <div style="width:100%;display:flex;flex-wrap:wrap;flex-direction:row;">
        @await Html.PartialAsync("_AddressPartialView", Model.Addresses.OrderBy(x => x.AdrIsPrimary).FirstOrDefault())
        @await Html.PartialAsync("_PhonePartialView", Model.Phones.OrderBy(x => x.PhoIsPrimary).FirstOrDefault())
        @await Html.PartialAsync("_EmailPartialView", Model.Emails.OrderBy(x => x.EmlIsPrimary).FirstOrDefault())
        @await Html.PartialAsync("_CredentialPartialView", Model.Customer.Credentials.OrderByDescending(x => x.Cr1AddDate).ToList())
        @await Html.PartialAsync("_ExamScorePartialView", Model.Customer.ExamScores.OrderByDescending(x => x.ExsAddDate).Take(5).ToList())
        @await Html.PartialAsync("_EventRegistrationPartialView", Model.Customer.EventRegistrations.OrderByDescending(x => x.EvrAddDate).Take(5).ToList())
    </div>
</div>
