@model ProjectMoonshine.EntityFramework.Models.Email

@{
    ViewData["Title"] = "Edit";
}

<h2>Edit</h2>

<h4>Email</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="EmlKey" />
            <div class="form-group">
                <label asp-for="EmlPerKey" class="control-label"></label>
                <input asp-for="EmlPerKey" class="form-control" />
                <span asp-validation-for="EmlPerKey" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmlAddress" class="control-label"></label>
                <input asp-for="EmlAddress" class="form-control" />
                <span asp-validation-for="EmlAddress" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="EmlIsPrimaryEmail" /> @Html.DisplayNameFor(model => model.EmlIsPrimaryEmail)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="EmlIsWorkEmail" /> @Html.DisplayNameFor(model => model.EmlIsWorkEmail)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="EmlIsPersonalEmail" /> @Html.DisplayNameFor(model => model.EmlIsPersonalEmail)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
            @Html.Hidden("RefAction", ViewBag.RefAction as string)
            @Html.Hidden("RefController", ViewBag.RefController as string)
            @Html.Hidden("RefId", ViewBag.RefId as string)
        </form>
    </div>
</div>

<div>
    <a asp-action="@ViewBag.RefAction" asp-route-controller="@ViewBag.RefController" asp-route-id="@ViewBag.RefId">Back</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
