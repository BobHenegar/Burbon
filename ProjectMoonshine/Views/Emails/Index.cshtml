@model IEnumerable<ProjectMoonshine.EntityFramework.Models.Email>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EmlPerKey)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmlAddress)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmlIsPrimaryEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmlIsWorkEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmlIsPersonalEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmlAddDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmlChangeDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmlAddUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmlChangeUser)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.EmlPerKey)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EmlAddress)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EmlIsPrimaryEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EmlIsWorkEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EmlIsPersonalEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EmlAddDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EmlChangeDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EmlAddUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EmlChangeUser)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EmlKey">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EmlKey">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.EmlKey">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
