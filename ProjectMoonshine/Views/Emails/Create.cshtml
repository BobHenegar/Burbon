@model ProjectMoonshine.EntityFramework.Models.Email

@{
    ViewData["Title"] = "Create";
}

<h2>Create</h2>

<h4>Email</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if ((bool)ViewBag.EmlPerKeyHasValue) {
                <div class="form-group">
                    <label asp-for="EmlPerKey" class="control-label"></label>
                    <select asp-for="EmlPerKey" class="form-control" asp-items="ViewBag.PerKey" readonly>
                        <option value="@ViewBag.Person.PerKey" selected="selected">@ViewBag.Person.PerFirstMiddleLast</option>
                    </select>
                </div>
            }
            else {
                <div class="form-group">
                    <label asp-for="EmlPerKey" class="control-label"></label>
                    <select asp-for="EmlPerKey" class="form-control" asp-items="ViewBag.EmlPerKey"></select>
                </div>
            }
            <div class="form-group">
                <label asp-for="EmlAddress" class="control-label"></label>
                <input asp-for="EmlAddress" class="form-control" />
                <span asp-validation-for="EmlAddress" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="EmlIsPrimary" /> @Html.DisplayNameFor(model => model.EmlIsPrimary)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="EmlIsWorkEmail" /> @Html.DisplayNameFor(model => model.EmlIsWorkEmail)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="EmlIsPersonalEmail" /> @Html.DisplayNameFor(model => model.EmlIsPersonalEmail)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

