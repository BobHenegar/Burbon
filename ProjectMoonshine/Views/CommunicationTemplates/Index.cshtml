@model IEnumerable<ProjectMoonshine.EntityFramework.Models.CommunicationTemplate>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TemCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TemDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TemHtml)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TemText)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TemAddDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TemChangeDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TemAddUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TemChangeUser)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TemCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TemDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TemHtml)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TemText)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TemAddDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TemChangeDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TemAddUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TemChangeUser)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.TemKey">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.TemKey">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.TemKey">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
