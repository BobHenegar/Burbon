@model IEnumerable<ProjectMoonshine.EntityFramework.Models.Event>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EvtDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EvtName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EvtStartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EvtEndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EvtAddDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EvtChangeDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EvtAddUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EvtChangeUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RowVersion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.EvtDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EvtName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EvtStartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EvtEndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EvtAddDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EvtChangeDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EvtAddUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EvtChangeUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RowVersion)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EvtKey">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EvtKey">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.EvtKey">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
