@model ProjectMoonshine.EntityFramework.Models.Event

<div class="form-group">
    <label asp-for="EvtDescription" class="control-label"></label>
    <input asp-for="EvtDescription" class="form-control"/>
    <span asp-validation-for="EvtDescription" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="EvtName" class="control-label"></label>
    <input asp-for="EvtName" class="form-control"/>
    <span asp-validation-for="EvtName" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="EvtStartDate" class="control-label"></label>
    <input asp-for="EvtStartDate" class="form-control" type="date"/>
    <span asp-validation-for="EvtStartDate" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="EvtEndDate" class="control-label"></label>
    <input asp-for="EvtEndDate" class="form-control" type="date"/>
    <span asp-validation-for="EvtEndDate" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="EvtRegistrantLimit" class="control-label"></label>
    <input asp-for="EvtRegistrantLimit" class="form-control" type="number"/>
    <span asp-validation-for="EvtRegistrantLimit" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="EvtExmKey" class="control-label"></label>
    @Html.DropDownListFor(e => e.EvtExmKey, (SelectList) ViewBag.EvtExmKey, "", new {@class = "form-control"})
    <span asp-validation-for="EvtExmKey" class="text-danger"></span>
</div>
            