@model ProjectMoonshine.EntityFramework.Models.Event

@{
    ViewData["Title"] = "Details";
}

<h2>Details</h2>

<div>
    <h4>Event</h4>
    <div style="width:100%;float:left;">
            <a asp-action="Edit" asp-route-id="@Model.EvtKey">Edit</a> | <a asp-action="Index">Back to List</a>
    </div>
    <div style="width:100%; height:250px;border-top:1px solid #eee">
        <dl class="dl-horizontal">
            <dt>
                @Html.DisplayNameFor(model => model.EvtName)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.EvtName)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.EvtDescription)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.EvtDescription)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.EvtStartDate)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.EvtStartDate)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.EvtEndDate)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.EvtEndDate)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.EvtRegistrantLimit)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.EvtRegistrantLimit)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.EvtExmKey)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Exam.ExmName)
            </dd>
        </dl>
    </div>
    <div style="width:100%;display:flex;flex-wrap:wrap;flex-direction:row;">
        @await Html.PartialAsync("_EventRegistrationPartialView", Model.EventRegistrations.OrderByDescending(x => x.EvrAddDate).Take(5).ToList())
    </div>
</div>
