@model IPagedList<ProjectMoonshine.EntityFramework.Models.ExamScore>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().ExsTotalPossible)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().ExsTotalReceived)
            </th>
            <th>
                @Html.ActionLink(@Html.DisplayNameFor(model => model.First().ExsAddDate), "Index", new { sortOrder = "addDate", lastOrder = ViewBag.LastSortParam, filterString = ViewBag.FilterString })
            </th>
            <th>
                @Html.ActionLink(@Html.DisplayNameFor(model => model.First().Customer.Person.PerFirstMiddleLast), "Index", new { sortOrder = "Customer Name", lastOrder = ViewBag.LastSortParam, filterString = ViewBag.FilterString })
            </th>
            <th>
                @Html.ActionLink(Html.DisplayNameFor(model => model.First().Exam.Event.EvtName), "Index", new { sortOrder = "Customer Name", lastOrder = ViewBag.LastSortParam, filterString = ViewBag.FilterString })
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ExsTotalPossible)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ExsTotalReceived)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ExsAddDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Customer.Person.PerFirstMiddleLast)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Exam.Event.EvtName)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ExsKey">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ExsKey">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ExsKey">Delete</a>
                </td>
            </tr>
        }
    </tbody>
    <pager class="pager-container" list="@Model" options="@PagedListRenderOptions.TwitterBootstrapPager" asp-action="Index" asp-controller="ExamScores" />
</table>
