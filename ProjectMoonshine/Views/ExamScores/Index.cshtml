@model IEnumerable<ProjectMoonshine.EntityFramework.Models.ExamScore>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ExsTotalPossible)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExsTotalReceived)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExsAddDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExsChangeDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExsAddUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExsChangeUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Customer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Exam)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RowVersion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ExsTotalPossible)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExsTotalReceived)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExsAddDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExsChangeDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExsAddUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExsChangeUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.CusKey)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Exam.ExmKey)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RowVersion)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ExsKey">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ExsKey">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ExsKey">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
