@model ProjectMoonshine.EntityFramework.Models.ExamScore


<div class="form-group">
    <label asp-for="ExsExmKey" class="control-label"></label>
    @Html.DropDownListFor(s => s.ExsExmKey, (SelectList) ViewBag.ExsExmKey , "", new {@class = "form-control"})
    @*<select asp-for="ExsExmKey" class="form-control" asp-items="ViewBag.ExsExmKey"></select>*@
    <span asp-validation-for="ExsExmKey" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="ExsCusKey" class="control-label"></label>
    <div><select asp-for="ExsCusKey" asp-items="ViewBag.ExsCusKey" class="form-control selectpicker show-tick" data-live-search="true"></select></div>
    <span asp-validation-for="ExsCusKey" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="ExsDate" class="control-label"></label>
    <input asp-for="ExsDate" class="form-control" type="date"/>
    <span asp-validation-for="ExsDate" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="ExsTotalPossible" class="control-label"></label>
    <input asp-for="ExsTotalPossible" class="form-control"/>
    <span asp-validation-for="ExsTotalPossible" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="ExsTotalReceived" class="control-label"></label>
    <input asp-for="ExsTotalReceived" class="form-control"/>
    <span asp-validation-for="ExsTotalReceived" class="text-danger"></span>
</div>
<div class="form-group">
    <div class="checkbox">
        <label>
            <input asp-for="ExsSuccessFlag"/> @Html.DisplayNameFor(model => model.ExsSuccessFlag)
        </label>
    </div>
</div>
@(await Html.PartialAsync("_RequirementDataRedirectSourcePartialView"))
           