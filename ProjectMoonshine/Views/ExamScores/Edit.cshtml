@model ProjectMoonshine.EntityFramework.Models.ExamScore

@{
    ViewData["Title"] = "Edit";
}

<h2>Edit</h2>

<h4>ExamScore</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ExsKey" />
            @(await Html.PartialAsync("_ExamScoresAddEditPartialView", Model))
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

@(await Html.PartialAsync("_RequirementDataRedirectSourcePartialView"))

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
