@model ProjectMoonshine.EntityFramework.Models.ExamScore

@{
    ViewData["Title"] = "Create";
}

<h2>Create</h2>

<h4>Exam Score</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {

            <div class="alert alert-danger" role="alert">
                @ViewBag.Error
            </div>
        }
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label class="control-label">Exam</label>
                <select asp-for="ExsExmKey" class="form-control" asp-items="ViewBag.ExsExmKey"></select>
            </div>
            @if ((bool)ViewBag.CusKeyHasValue)
            {
                <div class="form-group">
                    <label asp-for="ExsCusKey" class="control-label"></label>
                    <select asp-for="ExsCusKey" class="form-control" asp-items="ViewBag.ExsCusKey" readonly="true"></select>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label asp-for="ExsCusKey" class="control-label"></label>
                    <select asp-for="ExsCusKey" class="form-control" asp-items="ViewBag.ExsCusKey"></select>
                </div>
            }
            <div class="form-group">
                <label asp-for="ExsTotalPossible" class="control-label"></label>
                <input asp-for="ExsTotalPossible" class="form-control" />
                <span asp-validation-for="ExsTotalPossible" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ExsTotalReceived" class="control-label"></label>
                <input asp-for="ExsTotalReceived" class="form-control" />
                <span asp-validation-for="ExsTotalReceived" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
