    <span asp-validation-for="CredentialType.Ct1Description" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CredentialType.Ct1StartDate" class="control-label"></label>
    <input asp-for="CredentialType.Ct1StartDate" class="form-control" type="date" />
    <span asp-validation-for="CredentialType.Ct1StartDate" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CredentialType.Ct1EndDate" class="control-label"></label>
