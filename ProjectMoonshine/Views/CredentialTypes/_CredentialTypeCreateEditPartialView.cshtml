@model ProjectMoonshine.ViewModels.CredentialTypeViewModel

@{
    bool editMode = false;
    if (ViewBag.Action.Equals("edit"))
    {
        editMode = true;
    }
}
<div class="row">
    <div class="form-group col-lg-4">
        <label asp-for="CredentialType.Ct1Credential" class="control-label"></label>
        <input asp-for="CredentialType.Ct1Credential" class="form-control" />
        <span asp-validation-for="CredentialType.Ct1Credential" class="text-danger"></span>
    </div>
    <div class="form-group col-lg-4 col-lg-offset-4">
        <label asp-for="CredentialType.Ct1StartDate" class="control-label"></label>
        <input asp-for="CredentialType.Ct1StartDate" class="form-control" type="date"/>
        <span asp-validation-for="CredentialType.Ct1StartDate" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="form-group col-lg-4">
        <label asp-for="CredentialType.Ct1Description" class="control-label"></label>
        <input asp-for="CredentialType.Ct1Description" class="form-control"/>
        <span asp-validation-for="CredentialType.Ct1Description" class="text-danger"></span>
    </div>
    <div class="form-group col-lg-4 col-lg-offset-4">
        <label asp-for="CredentialType.Ct1EndDate" class="control-label"></label>
        <input asp-for="CredentialType.Ct1EndDate" class="form-control" type="date"/>
        <span asp-validation-for="CredentialType.Ct1EndDate" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="form-group col-lg-4">
        <label asp-for="CredentialType.Ct1InitCt2Key" class="control-label"></label>
        @Html.DropDownListFor(ct => ct.CredentialType.Ct1InitCt2Key, Model.InitProcessTypeSelectList, "", new {@class = "form-control"})
        <span asp-validation-for="CredentialType.Ct1InitCt2Key" class="text-danger"></span>
    </div>
    <div class="form-group col-lg-4">
        <label asp-for="CredentialType.Ct1InitCt6Key" class="control-label"></label>
        @Html.DropDownListFor(ct => ct.CredentialType.Ct1InitCt6Key, Model.InitStatusTypeSelectList, "", new {@class = "form-control"})
        <span asp-validation-for="CredentialType.Ct1InitCt6Key" class="text-danger"></span>
    </div>
    <div class="form-group col-lg-1 col-lg-offset-1">
        <label asp-for="CredentialType.Ct1Order" class="control-label"></label>
        <input asp-for="CredentialType.Ct1Order" class="form-control"/>
        <span asp-validation-for="CredentialType.Ct1Order" class="text-danger"></span>
    </div>
</div>
<div class="row">
<div class="form-group col-lg-4">
    <label asp-for="CredentialType.Ct1RenewCt2Key" class="control-label"></label>
    @Html.DropDownListFor(ct => ct.CredentialType.Ct1RenewCt2Key, Model.RenewProcessTypeSelectList, "", new {@class = "form-control"})
    <span asp-validation-for="CredentialType.Ct1RenewCt2Key" class="text-danger"></span>
</div>
<div class="form-group col-lg-4">
    <label asp-for="CredentialType.Ct1RenewCt6Key" class="control-label"></label>
    @Html.DropDownListFor(ct => ct.CredentialType.Ct1RenewCt6Key, Model.RenewStatusTypeSelectList, "", new {@class = "form-control"})
    <span asp-validation-for="CredentialType.Ct1RenewCt6Key" class="text-danger"></span>
</div>
</div>

