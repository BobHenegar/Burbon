@model ProjectMoonshine.ViewModels.CEDetailViewModel


<div class="form-group">
    <label asp-for="CeDetail.Ce1CusKey" class="control-label"></label>

    @Html.DropDownListFor(d => d.CeDetail.Ce1CusKey, (SelectList) ViewBag.Ce1CusKey, "", new { @class = "form-control" })
    @*<select asp-for="CeDetail.Ce1CusKey" class ="form-control" asp-items="ViewBag.Ce1CusKey"></select>*@
</div>
<div class="form-group">
    <label asp-for="CeDetail.Ce1ActivityDate" class="control-label"></label>
    <input asp-for="CeDetail.Ce1ActivityDate" class="form-control" type="date" />
    <span asp-validation-for="CeDetail.Ce1ActivityDate" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CeDetail.Ce1CetKey" class="control-label"></label>
    @Html.DropDownListFor(d => d.CeDetail.Ce1CetKey, Model.Ce1CetKeySelectList, "", new { @class = "form-control" })
    <span asp-validation-for="CeDetail.Ce1CetKey" class="text-danger"></span>
    @*<select asp-for="CeDetail.Ce1CetKey" class ="form-control" asp-items="ViewBag.Ce1CetKey"></select>*@
</div>
<div class="form-group">
    <label asp-for="CeDetail.Ce1ActivityDescription" class="control-label"></label>
    <input asp-for="CeDetail.Ce1ActivityDescription" class="form-control" />
    <span asp-validation-for="CeDetail.Ce1ActivityDescription" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CeDetail.Ce1Units" class="control-label"></label>
    <input asp-for="CeDetail.Ce1Units" class="form-control" />
    <span asp-validation-for="CeDetail.Ce1Units" class="text-danger"></span>
</div>
<div class="form-group">
    <div class="checkbox">
        <label>
            <input asp-for="CeDetail.Ce1VerifiedFlag" /> @Html.DisplayNameFor(model => model.CeDetail.Ce1VerifiedFlag)
        </label>
    </div>
</div>
@await Html.PartialAsync("_RequirementDataRedirectSourcePartialView")
