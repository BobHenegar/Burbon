@model IEnumerable<ProjectMoonshine.EntityFramework.Models.Email>

@{
    ViewData["Title"] = "Index";
}

<div style="width:100%;padding:0px 15px 0px 15px">
<p>

    <div class="row">
        <div class="col-lg-12">
            <button class="btn btn-primary btn-block" type="button" data-toggle="collapse" data-target="#emailTarget" aria-expanded="false" aria-controls="emailTarget">
                Email Addresses
            </button>
        </div>
    </div>
</p>
<div class="collapse" id="emailTarget">
<div class="card card-body" style="width:100%;min-width:320px;height:150px;">
<a asp-action="Create" asp-controller="Emails" asp-route-id="@ViewData["PerCusKey"]">Add Email</a>
@if (Model != null && Model.Count() > 0)
{
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().EmlAddress)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().EmlIsPrimary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().EmlIsWorkEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().EmlIsPersonalEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().EmlAddDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.EmlAddress)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmlIsPrimary)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmlIsWorkEmail)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmlIsPersonalEmail)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmlAddDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmlChangeDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmlAddUser)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmlChangeUser)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EmlKey">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.EmlKey">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.EmlKey">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
}
else
{
    <div>
        <div>
            <p>No Emails Currently on Record</p>
        </div>
    </div>
}
        </div>
    </div>
</div>