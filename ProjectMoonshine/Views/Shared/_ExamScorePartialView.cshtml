@model IEnumerable<ProjectMoonshine.EntityFramework.Models.ExamScore>

<div style="width:100%;padding:0px 15px 0px 15px">
    <p>
        <button style="width:100%" class="btn btn-primary" type="button" data-toggle="collapse" data-target="#examScoresTarget" aria-expanded="false" aria-controls="examScoresTarget">
            Exam Scores
        </button>
    </p>
    <div class="collapse" id="examScoresTarget">
        <div class="card card-body" style="width:100%;min-width:320px;height:150px;">
            <a asp-action="Create" asp-controller="ExamScores" asp-route-customerKey="@ViewBag.PerCusKey">Add Score</a>
            @if (Model != null && Model.Count() > 0)
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.ExsExmKey)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.ExsDate)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.ExsTotalReceived)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.ExsTotalPossible)
                            </th>
                            
                            
                            <th>
                                @Html.DisplayNameFor(model => model.ExsSuccessFlag)
                            </th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Exam.ExmName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ExsDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ExsTotalPossible)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ExsTotalReceived)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ExsSuccessFlag)
                            </td>
                            <td>
                                <a asp-action="Edit" asp-controller="ExamScores" asp-route-id="@item.ExsKey" asp-route-customerKey="@item.ExsCusKey">Edit Score</a>
                            </td>
                            <td></td>
                        </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div>
                    <div>
                        <p>No Exam Scores on Record</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
