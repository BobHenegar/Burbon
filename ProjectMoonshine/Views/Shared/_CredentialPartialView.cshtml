@model IEnumerable<ProjectMoonshine.EntityFramework.Models.Credential>

<div style="width:100%;padding:0px 15px 0px 15px">
    <p>

    <div class="row">
        <div class="col-lg-1">
        <button class="btn btn-primary btn-block" type="button" data-toggle="collapse" data-target="#credentialTarget" aria-expanded="false" aria-controls="credentialTarget">
            <span class="glyphicon glyphicon-plus-sign"></span>
        </button>
    </div>
        <div class="col-lg-11">
            <button class="btn btn-primary btn-block" type="button" data-toggle="collapse" data-target="#credentialTarget" aria-expanded="false" aria-controls="credentialTarget">
                Credentials
            </button>
        </div>
    </div>
    </p>
    <div class="collapse" id="credentialTarget">
        <div class="card card-body" style="width:100%;min-width:320px;height:150px;">
            <a asp-action="Create" asp-controller="Credentials" asp-route-id="@ViewData["PerCusKey"]">Add Credential</a>
            @if (Model != null && Model.Count() > 0)
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.CredentialType.Ct1Credential)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Cr1StartDate)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Cr1ValidThruDate)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.StatusType.Ct6Code)
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CredentialType.Ct1Credential)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Cr1StartDate)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Cr1ValidThruDate)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.StatusType.Ct6Code)
                                </td>
                                <td>
                                    <a asp-action="Details" asp-controller="CredentialProcesses" asp-route-id="@item.Cr1CurrentCr2Key">View Current Process</a>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-controller="Credentials" asp-route-id="@item.Cr1Key">View Credential</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div>
                    <div>
                        <p>No Credentails Currently on Record</p>
                    </div>
                </div>
            }
        </div>
        </div>
    </div>
