@model IPagedList<ProjectMoonshine.EntityFramework.Models.CredentialProcess>

@{
    ViewData["Title"] = "Index";
}


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().CredentialProcessType.Ct2Process)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Cr2TerminationDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Cr2AddUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Cr2AddDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Cr2ChangeUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Cr2ChangeDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().StatusType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CredentialProcessType.Ct2Process)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr2TerminationDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr2AddUser)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr2AddDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr2ChangeUser)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr2ChangeDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StatusType.Ct6Code)
                </td>
                <td>
                    <a asp-controller="Credentials" asp-action="Details" asp-route-id="@item.Cr2Cr1Key">Details</a>
                </td>
            </tr>
        }
    </tbody>
    <pager class="pager-container" list="@Model" options="@PagedListRenderOptions.TwitterBootstrapPager" asp-action="Index" asp-controller="Home" />
</table>
