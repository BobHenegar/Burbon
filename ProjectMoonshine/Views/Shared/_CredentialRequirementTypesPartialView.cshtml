@model IEnumerable<ProjectMoonshine.EntityFramework.Models.CredentialRequirementType>

@{
    string controlId = Guid.NewGuid().ToString();
}
<div style="width: 100%; padding: 0px 15px 0px 15px">

    @if (Model != null)
    {

        <p>
            <button class="btn btn-default btn-xs btn-success" type="button" data-toggle="collapse" data-target="#@controlId" aria-expanded="false" aria-controls="@controlId">
                <span class="glyphicon glyphicon-list"></span>
            </button>
            <button data-toggle="modal" data-target="#@ViewData["ct2Process"]" class="btn btn-default btn-xs text-center btn-success" data-button-id="#@ViewData["ct2Key"]">
                <span class="glyphicon-plus"></span>
            </button>
        </p>
        <div class="collapse" id="@controlId">
            <div class="card card-body" style="width: 100%; min-width: 320px;">
                <table class="table">
                    <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Ct3Requirement)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Ct3Description)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Ct3AddDate)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Ct3ChangeDate)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Ct3AddUser)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Ct3ChangeUser)
                        </th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Ct3Requirement)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Ct3Description)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Ct3AddDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Ct3ChangeDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Ct3AddUser)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Ct3ChangeUser)
                            </td>
                            <td>
                                <a asp-controller="CredentialRequirementTypes" asp-action="Edit" asp-route-id="@item.Ct3Key">Edit</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div>
            <div>
                <p>No Requirements Defined</p>
            </div>
        </div>
    }
</div>
    
<!-- RequirementModal -->
<div class="modal fade" id="@ViewData["ct2Process"]" tabindex="-1" role="dialog" aria-labelledby="addProcessModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalLabel">Add Requirement to @ViewData["ct2Process"]</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Select Process to add new association.
                <form asp-controller="CredentialProcessTypes" asp-action="AddRequirementType">
                    <div class="form-group">
                        <input type="hidden" name="ct2Key" value="@ViewData["ct2Key"]" />
                        @Html.DropDownList("Ct3Requirements")
                        @Html.DropDownList("Ct8Templates")
                        <input type="text" name="ct3Name" value="" />
                    </div>
                    <button id="ct4s" name="Submit" type="submit" class="btn btn-sm btn-primary" value="Submit">Submit</button>
                    <button id="ct4x" name="Submit" type="submit" class="btn btn-sm btn-secondary" value="Cancel" data-dismiss="modal">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>