@model ProjectMoonshine.EntityFramework.Models.Address

<div class="col-lg-4 col-md-4" style="padding:20px 15px 20px 15px">
    <h4>Primary Address</h4>
    <div border-top:1px solid #eee">
        <div>
            <a asp-action="Create" asp-controller="Address" asp-route-id="@ViewBag.PerCusKey">Add Address</a>
        </div>
        @if (Model != null && Model.AdrIsPrimary)
        {
            <div>
                <a asp-action="Edit" asp-controller="Addresses" asp-route-id="@Model.AdrKey">Edit Address</a>
            </div>
            @if (Model.AdrIsHomeAddress
                || Model.AdrIsWorkAddress
                || Model.AdrIsMailingAddress)
            {
            <div class="col-lg-6">
                @if (Model.AdrIsHomeAddress)
                {
                    <span class="glyphicon glyphicon-home" style="float:right"></span>
                }
                else if (Model.AdrIsWorkAddress)
                {
                <span class="glyphicon glyphicon-briefcase" style="float:right"></span>
                }
                @if (Model.AdrIsMailingAddress)
                {
                    <span class="glyphicon glyphicon-envelope" style="float:right"></span>
                }
            </div>
            }
            <div class="col-lg-12">
                <dl class="dl-horizontal">
                    <dt>
                        @Html.DisplayNameFor(model => model.AdrAddress1)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.AdrAddress1)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.AdrAddress2)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.AdrAddress2)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.AdrAddress3)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.AdrAddress3)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.AdrCity)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.AdrCity)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.AdrState)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.AdrState)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.AdrZip)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.AdrZip)
                    </dd>
                </dl>
            </div>
            <div class="col-lg-12" style="border-top:1px solid #eee;">
                <div class="row col-lg-6">
                    <dl class="dl-horizontal">
                        <dt>
                            @Html.DisplayNameFor(model => model.AdrIsPrimary)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.AdrIsPrimary)
                        </dd>
                        <dt>
                            @Html.DisplayNameFor(model => model.AdrIsMailingAddress)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.AdrIsMailingAddress)
                        </dd>
                    </dl>
                </div>
                <div class="row col-lg-6">
                    <dl class="dl-horizontal">
                        <dt>
                            @Html.DisplayNameFor(model => model.AdrIsWorkAddress)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.AdrIsWorkAddress)
                        </dd>
                        <dt>
                            @Html.DisplayNameFor(model => model.AdrIsHomeAddress)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.AdrIsHomeAddress)
                        </dd>
                    </dl>
                </div>
            </div>
        }
        else
        {
            <div>
                <p>No Primary Addresses on Record</p>
            </div>
        }
    </div>
</div>
