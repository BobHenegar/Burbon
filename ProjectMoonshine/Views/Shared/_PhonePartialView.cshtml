@model ProjectMoonshine.EntityFramework.Models.Phone

<div class="col-lg-4 col-md-4" style="padding:20px 5px 20px 5px;">
    <div style="border-left: 1px solid #eee;border-right: 1px solid #eee; padding-left:10px; padding-right:15px;">
        <h4>Primary Phone</h4>
        @if (Model != null && Model.PhoIsPrimary)
        {
            if (Model.PhoIsHome)
            {
                <span class="glyphicon glyphicon-home" style="float:right"></span>
            }
            else
            {
                <span class="glyphicon glyphicon-briefcase" style="float:right"></span>
            }
            <div>
                <a asp-action="Create" asp-controller="Phones" asp-route-id="@ViewBag.PerKey">Add Phone</a>
            </div>
            <div>
                <a asp-action="Edit" asp-controller="Phones" asp-route-id="@Model.PhoKey">Edit Phone</a>
            </div>
            <div border-top:1px solid #eee">
                <dl class="dl-horizontal">
                    <dt>
                        @Html.DisplayNameFor(model => model.PhoNumber)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.PhoNumber)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.PhoExtention)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.PhoExtention)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.PhoIsPrimary)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.PhoIsPrimary)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.PhoIsHome)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.PhoIsHome)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.PhoIsMobile)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.PhoIsMobile)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.PhoIsWork)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.PhoIsWork)
                    </dd>
                </dl>
            </div>
        }
        else
        {
            <div>
                <p>No Phones on Record</p>
            </div>
            <div>
                <a asp-action="Create" asp-controller="Phones" asp-route-id="@ViewBag.PerKey">Add Phone</a>
            </div>
        }
    </div>
</div>
