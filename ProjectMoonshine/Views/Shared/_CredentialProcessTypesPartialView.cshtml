@using ProjectMoonshine.EntityFramework.Models
@model IEnumerable<ProjectMoonshine.EntityFramework.Models.CredentialProcessType>
@{
    string controlId = Guid.NewGuid().ToString();
}
<div style="width: 100%; padding: 0px 15px 0px 15px">

    @if (Model != null)
    {
        <div class="row">
            <div class="col-1">
                <button class="btn btn-default btn-xs text-center" type="button" data-toggle="collapse" data-target="#@controlId" aria-expanded="false" aria-controls="@controlId" ToolTip="Show all accociated processes">
                    <span class="glyphicon glyphicon-list"></span>
                </button>
                <button data-toggle="modal" data-target="#@ViewData["ct1Credential"]" class="btn btn-default btn-xs text-center" data-button-id="#@ViewData["ct1Key"]" ToolTip="Add a process">
                    <span class="glyphicon-plus"></span>
                </button>
            </div>
            <div class="collapse col-2" id="@controlId">
                <div class="card card-body" style="min-width: 320px;">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.Ct2Process)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Ct2Description)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Ct2AddDate)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Ct2ChangeDate)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Ct2AddUser)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Ct2ChangeUser)
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Ct2Process)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Ct2Description)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Ct2AddDate)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Ct2ChangeDate)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Ct2AddUser)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Ct2ChangeUser)
                                    </td>
                                    <td>
                                        <a asp-controller="CredentialProcessTypes" asp-action="Edit" asp-route-id="@item.Ct2Key">Edit</a>
                                    </td>

                                </tr>
                                <tr>
                                    <td colspan="6">
                                        <div style="width: 100%; display: flex; flex-wrap: wrap; flex-direction: row;">
                                            @await Html.PartialAsync("_CredentialRequirementTypesPartialView",
                                                item.CredentialProcessTypeXCredentialRequirementTypes.Select(i => i.CredentialRequirementType),
                                                new ViewDataDictionary(this.ViewData){ {"ct2Key", item.Ct2Key.ToString()}, { "ct2Process", item.Ct2Process } })
                                        </div>

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    }
    else
    {
        <div>
            <div>
                <p>No Processes Defined</p>
            </div>
        </div>
    }
</div>


<!-- ProcessModal -->
<div class="modal fade" id="@ViewData["ct1Credential"]" tabindex="-1" role="dialog" aria-labelledby="addProcessModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalLabel">Add Process to @ViewData["ct1Credential"]</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Select Process to add new association.
                <form asp-controller="CredentialTypes" asp-action="AddProcessType">
                    <div class="form-group">
                        <input type="hidden" name="ct1Key" value="@ViewData["ct1Key"]" />
                        @Html.DropDownList("Ct2Processes")
                        <input type="text" name="ct2Name" value=""/>
                    </div>
                    <button id="ct4s" name="Submit" type="submit" class="btn btn-sm btn-primary" value="Submit">Submit</button>
                    <button id="ct4x" name="Submit" type="submit" class="btn btn-sm btn-secondary" value="Cancel" data-dismiss="modal">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $('#Ct2Processes').change(function() {
        if ($('#target').val() =="Create New"){
            $('#ct4Name').hide();
        }else{
            $('#ct4Name').show();
        }

    });

</script>