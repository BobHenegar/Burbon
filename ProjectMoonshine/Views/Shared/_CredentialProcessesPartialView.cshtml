@model IEnumerable<ProjectMoonshine.EntityFramework.Models.CredentialProcess>

@{
    ViewData["Title"] = "Index";
}
<div style="padding:50px 15px 50px 15px">
    
@if (Model != null)
{
    <table class="table">
        <thead>
        <tr>
            <th>
                 Current Process
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CredentialProcessType.Ct2Process)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cr2StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cr2DueDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cr2SubmitDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cr2CompletionDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cr2TerminationDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StatusType)
            </th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td align="center">
                    @{
                        if (item.Cr2CompletionDate == null && item.Cr2TerminationDate == null)
                        {
                            <span class="glyphicon glyphicon-ok" style="color:green"></span>
                        }
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CredentialProcessType.Ct2Process)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Cr2StartDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr2DueDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr2SubmitDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr2CompletionDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr2TerminationDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StatusType.Ct6Code)
                </td>
                <td>
                    <a asp-controller="CredentialProcesses" asp-action="Details" asp-route-id="@item.Cr2Key">Details</a>
                </td>
            </tr><tr>
                <td colspan="9">
                    @await Html.PartialAsync("_CredentialRequirementsPartialView", item.CredentialRequirements)

                </td>
            </tr>
        }
        </tbody>
    </table>
}
</div>
