<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CredEngNext</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/lib/boostrap-select/css/bootstrap-select.min.css" />
</head>
<body>

    <div id="container">
        <div id="header">
            <div class="col-lg-12">
                <partial name="_Navbar" />
                <partial name="_CookieConsentPartial" />
            </div>
        </div>
        <div id="body">
            <div class="body-content">
                <div class="container">
                    <div class="col-lg-12">
                        <div class="col-lg-12">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="footer">
            <div class="footer">
                <div style="height:25px;width:200px;">
                    <p style="float:left;">&copy; 2018 - Agilutions</p>
                    <img src="~/images/Swoosh_nobackground.png" style="height: 25px;float:right;" />
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/js/site.min.js" asp-append-version="true"></script>
    <script src="~/lib/boostrap-select/js/bootstrap-select.min.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
