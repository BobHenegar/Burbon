<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CredEngNext</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.9/summernote.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/boostrap-select/css/bootstrap-select.min.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <partial name="_Navbar" />
        <partial name="_CookieConsentPartial" />
    </header>
    <main role="main">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    @RenderBody()
                </div>
                
            </div>
        </div>
        <footer class="page-footer font-small navbar-fixed-bottom footer">
            <div class="footer-copyright text-center py-3 black">
                &copy; 2018 - Agilutions
                <img src="~/images/Swoosh_nobackground.png" style="height: 25px;" />
            </div>
        </footer>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/js/site.min.js" asp-append-version="true"></script>
<script src="~/lib/boostrap-select/js/bootstrap-select.min.js" asp-append-version="true"></script>



    @RenderSection("Scripts", required: false)
</body>
</html>
