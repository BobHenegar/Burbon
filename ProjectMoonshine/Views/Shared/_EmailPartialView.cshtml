@model ProjectMoonshine.EntityFramework.Models.Email

<div style="width:50%;min-width:250px;height:300px;padding:20px 15px 20px 15px">
    <h4>Primary Email</h4>
    @if (Model != null)
    {
        <div style="width:100%;float:left;">
            <a style="float:right;" asp-action="Edit" asp-controller="Emails" asp-route-id="@Model.EmlKey">Edit Email</a>
        </div>
    }
    <div style="width:70%; height:250px;border-top:1px solid #eee">
        @if (Model.EmlIsPrimary)
        {

            <div style="width:100%; height:250px;border-top:1px solid #eee">
                <dl class="dl-horizontal">
                    <dt>
                        @Html.DisplayNameFor(model => model.EmlAddress)
                    </dt>
                    <dd style="text-overflow:ellipsis; word-wrap:break-word;">
                        @Html.DisplayFor(model => model.EmlAddress)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.EmlIsPrimary)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.EmlIsPrimary)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.EmlIsWorkEmail)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.EmlIsWorkEmail)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.EmlIsPersonalEmail)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.EmlIsPersonalEmail)
                    </dd>
                </dl>
            </div>
        }
        else
        {
            <div>
                <div>
                    <p>No Primary Email on Record</p>
                </div>
                <div>
                    <a asp-action="Create" asp-controller="Emails" asp-route-id="@Model.EmlPerKey">Add Primary Address</a>
                </div>
            </div>
        }
    </div>
</div>
