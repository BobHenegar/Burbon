@model ProjectMoonshine.EntityFramework.Models.Email

<div style="width:50%;">
    <h4>Email</h4>
    <hr />
    <dl class="dl-horizontal">
        @if (Model != null)
        {
        <dt>
            @Html.DisplayNameFor(model => model.EmlAddress)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.EmlAddress)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.EmlIsPrimaryEmail)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.EmlIsPrimaryEmail)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.EmlIsWorkEmail)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.EmlIsWorkEmail)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.EmlIsPersonalEmail)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.EmlIsPersonalEmail)
        </dd>
        }
        else
        {
        <dd>
            <p>No Emails on Record</p>
        </dd>
        }
    </dl>
    @if (Model != null)
    {
    <div>
        <a style="float:right;" asp-action="Edit" asp-route-id="@Model.EmlKey">Edit Email</a>
    </div>
    }
</div>
