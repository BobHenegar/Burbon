@model ProjectMoonshine.EntityFramework.Models.Email

<div class="col-lg-4 col-md-4" style="padding:20px 15px 20px 15px">
    <h4>Primary Email</h4>
        @if (Model != null && Model.EmlIsPrimary)
        {
            if (Model.EmlIsPersonalEmail)
            {
                <span class="glyphicon glyphicon-home" style="float:right"></span>
            }
            else
            {
                <span class="glyphicon glyphicon-briefcase" style="float:right"></span>
            }
            <div>
                <a asp-action="Create" asp-controller="Emails" asp-route-id="@ViewBag.PerKey">Add Email</a>
            </div>
            <div>
                <a asp-action="Edit" asp-controller="Emails" asp-route-id="@Model.EmlKey">Edit Email</a>
            </div>
            <div border-top:1px solid #eee">
                <dl class="dl-horizontal">
                    <dt>
                        @Html.DisplayNameFor(model => model.EmlAddress)
                    </dt>
                    <dd style="text-overflow:ellipsis; word-wrap:break-word;">
                        @Html.DisplayFor(model => model.EmlAddress)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.EmlIsPrimary)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.EmlIsPrimary)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.EmlIsWorkEmail)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.EmlIsWorkEmail)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.EmlIsPersonalEmail)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.EmlIsPersonalEmail)
                    </dd>
                </dl>
            </div>
        }
        else
        {
            <div>
                <p>No Primary Email on Record</p>
            </div>
            <div>
                <a asp-action="Create" asp-controller="Emails" asp-route-id="@ViewBag.PerKey">Add Email</a>
            </div>
        }
    </div>
