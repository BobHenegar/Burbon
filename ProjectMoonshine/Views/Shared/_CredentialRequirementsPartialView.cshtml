@model IEnumerable<ProjectMoonshine.EntityFramework.Models.CredentialRequirement>

@{
    string controlId = Guid.NewGuid().ToString();
}
<div padding: 0px 15px 15px;>

        <div class="row">

            <div class="col-lg-8 col-lg-offset-1">

                <div class="collapse" id="@controlId">
                    <div class="card card-body" style="min-width: 320px;">
                        <table class="table">
                            <thead>
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.CredentialRequirementType.Ct3Requirement)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Status)
                                </th>
                                <th>@Html.DisplayNameFor(model => model.Cr3StartDate)</th>
                                <th>@Html.DisplayNameFor(model => model.Cr3DueDate)</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.CredentialRequirementType.Ct3Requirement)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Status.Ct6Code)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Cr3StartDate)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Cr3DueDate)
                                    </td>
                                    <td>
                                        <a asp-controller="CredentialRequirements" asp-action="Details" asp-route-id="@item.Cr3Key">Details</a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-1 col-lg-offset-2 align-content-right">
                <p>
                    <button class="btn btn-default btn-xs btn-success" type="button" data-toggle="collapse" data-target="#@controlId" aria-expanded="false" aria-controls="@controlId">
                        <span class="glyphicon glyphicon-list"></span>
                    </button>
                </p>
            </div>
        </div>
  
</div>