@model IEnumerable<ProjectMoonshine.EntityFramework.Models.Phone>

@{
    ViewData["Title"] = "Index";
}

<div style="width:100%;padding:0px 15px 0px 15px">
    <p>

        <div class="row">
            <div class="col-lg-12">
                <button class="btn btn-primary btn-block" type="button" data-toggle="collapse" data-target="#phoneTarget" aria-expanded="false" aria-controls="phoneTarget">
                    Phone Numbers
                </button>
            </div>
        </div>
    </p>
    <div class="collapse" id="phoneTarget">
        <div class="card card-body" style="width:100%;min-width:320px;height:150px;">
            <a asp-action="Create" asp-controller="Phones" asp-route-id="@ViewData["PerCusKey"]">Add Phone</a>
            @if (Model != null && Model.Count() > 0)
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().PhoNumber)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().PhoExtention)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().PhoIsPrimary)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().PhoIsHome)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().PhoIsMobile)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().PhoIsWork)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().PhoAddDate)
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PhoNumber)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PhoExtention)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PhoIsPrimary)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PhoIsHome)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PhoIsMobile)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PhoIsWork)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PhoAddDate)
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.PhoKey">Edit</a> |
                                    <a asp-action="Details" asp-route-id="@item.PhoKey">Details</a> |
                                    <a asp-action="Delete" asp-route-id="@item.PhoKey">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div>
                    <div>
                        <p>No Phone Numbers Currently on Record</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>