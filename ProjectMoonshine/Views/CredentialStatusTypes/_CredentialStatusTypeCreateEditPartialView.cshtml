@model ProjectMoonshine.ViewModels.CredentialStatusTypeViewModel
<div class="form-group">
    <label asp-for="CredentialStatusType.Ct6Code" class="control-label"></label>
    <input asp-for="CredentialStatusType.Ct6Code" class="form-control" />
    <span asp-validation-for="CredentialStatusType.Ct6Code" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CredentialStatusType.Ct6Description" class="control-label"></label>
    <input asp-for="CredentialStatusType.Ct6Description" class="form-control" />
    <span asp-validation-for="CredentialStatusType.Ct6Description" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CredentialStatusType.Ct6Cu6Key" class="control-label"></label>
    @Html.DropDownListFor(st => st.CredentialStatusType.Ct6Cu6Key, Model.Ct6Cu6KeySelectList, "", new { @class = "form-control" })
</div>