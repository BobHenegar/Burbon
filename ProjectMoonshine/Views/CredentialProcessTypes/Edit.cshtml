@model ProjectMoonshine.ViewModels.CredentialProcessTypeViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit</h2>

<h4>CredentialProcessType</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="CredentialProcessType.Ct2Key" />
            @await Html.PartialAsync("_CredentialProcessTypeCreateEditView", Model)
            <div class="form-group">
                @{
                    if (ViewData["ct4Key"].ToString().Length>0)
                    {
                        <input type="hidden" value="CredentialType" name="source" id="source" />
                        <input type="hidden" value="@ViewData["ct4Key"].ToString()" name="ct4Key" id="ct4Key" />

                    }
                    else
                    {
                        <input type="hidden" value="ProcessType" name="source" id="source" />
                        <input type="hidden" value="" name="ct4Key" id="ct4Key" />
                    }
                    <input type="submit" value="Save" class="btn btn-default" />
                }
            </div>
        </form>
    </div>
</div>

<div>
    @{
        if (!Context.Request.Headers["Referer"].ToString().Contains("CredentialTypes"))
        {
            <a asp-action="Index">Back to List</a>
        }
    }
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
