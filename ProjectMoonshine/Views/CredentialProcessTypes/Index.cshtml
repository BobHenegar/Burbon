@model IEnumerable<ProjectMoonshine.EntityFramework.Models.CredentialProcessType>

@{
    ViewData["Title"] = "Processes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<h2>Processes</h2>

<div class="col-lg-2">
    <a class="btn btn-primary btn-block" asp-area="" asp-action="Create">Create New</a>
    <a class="btn btn-info btn-block" asp-area="" asp-controller="CredentialTypes" asp-action="Index">Back to Setup</a>
</div>
<div class="col-lg-10">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Ct2Process)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Ct2Description)
                </th>
                <th>@Html.DisplayNameFor(model => model.Ct2ProcessType)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Ct2Process)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Ct2Description)
                    </td>
                    <td>@Html.DisplayFor(model => item.Ct2ProcessType)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Ct2Key">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Ct2Key">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Ct2Key">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
 </div>