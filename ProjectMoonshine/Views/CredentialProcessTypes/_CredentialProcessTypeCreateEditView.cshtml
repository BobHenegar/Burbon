@using GlobalConstants = ProjectMoonshine.EntityFramework.GlobalConstants
@model ProjectMoonshine.ViewModels.CredentialProcessTypeViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="form-group">
    <label asp-for="CredentialProcessType.Ct2Process" class="control-label"></label>
    <input asp-for="CredentialProcessType.Ct2Process" class="form-control" />
    <span asp-validation-for="CredentialProcessType.Ct2Process" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CredentialProcessType.Ct2Description" class="control-label"></label>
    <input asp-for="CredentialProcessType.Ct2Description" class="form-control" />
    <span asp-validation-for="CredentialProcessType.Ct2Description" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CredentialProcessType.Ct2ProcessType" class="control-label"></label>
    @Html.DropDownListFor(pt => pt.CredentialProcessType.Ct2ProcessType, Model.Ct2ProcessTypeSelectList, "", new { @class = "form-control" })
</div>
<div class="form-group">
    <label asp-for="CredentialProcessType.Ct2StartCt6Key" class="control-label"></label>
    @Html.DropDownListFor(pt => pt.CredentialProcessType.Ct2StartCt6Key, Model.Ct2StartCt6KeySelectList, "", new { @class = "form-control" })
</div>
<div class="form-group">
    <label asp-for="CredentialProcessType.Ct2SubmittedCt6Key" class="control-label"></label>
    @Html.DropDownListFor(pt => pt.CredentialProcessType.Ct2SubmittedCt6Key, Model.Ct2SubmittedCt6KeySelectList, "", new { @class = "form-control" })
</div>
<div class="form-group">
    <label asp-for="CredentialProcessType.Ct2CompletedCt6Key" class="control-label"></label>
    @Html.DropDownListFor(pt => pt.CredentialProcessType.Ct2CompletedCt6Key, Model.Ct2CompletedCt6KeySelectList, "", new { @class = "form-control" })
</div>

<div class="form-group">
    <label asp-for="CredentialProcessType.Ct2NextCt2Key" class="control-label"></label>
    @Html.DropDownListFor(pt => pt.CredentialProcessType.Ct2NextCt2Key, Model.Ct2NextCt2KeySelectList, "", new { @class = "form-control" })
</div>

<div class="form-group">
    <label asp-for="CredentialProcessType.Ct2DueDateNumber" class="control-label"></label>
    <input asp-for="CredentialProcessType.Ct2DueDateNumber" class="form-control" type="number" min="0"/>
    <span asp-validation-for="CredentialProcessType.Ct2DueDateNumber" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="CredentialProcessType.Ct2DueDateUnit" class="control-label"></label>
    @Html.DropDownListFor(pt => pt.CredentialProcessType.Ct2DueDateUnit, Html.GetEnumSelectList<GlobalConstants.DueDateUnit>(), new { @class = "form-control" })
</div>

<div class="form-group">
    <label asp-for="CredentialProcessType.Ct2DueDateRounding" class="control-label"></label>
    @Html.DropDownListFor(pt => pt.CredentialProcessType.Ct2DueDateRounding, Html.GetEnumSelectList<GlobalConstants.DueDateRounding>(), new { @class = "form-control" })
</div>