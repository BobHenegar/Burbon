@model ProjectMoonshine.EntityFramework.Models.License

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Create</h2>

<h4>License</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @(await Html.PartialAsync("_LicenseAddEditPartialView", Model))
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

@(await Html.PartialAsync("_GoBackToRequirementPersonDefaultPartialView"))

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
