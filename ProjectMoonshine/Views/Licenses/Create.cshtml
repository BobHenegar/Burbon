@model ProjectMoonshine.EntityFramework.Models.License

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Create</h2>

<h4>License</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="IxlCusKey" class="control-label"></label>
                <select asp-for="IxlCusKey" class="form-control" asp-items="ViewBag.IxlCusKey"></select>
            </div>
            <div class="form-group">
                <label asp-for="IxlState" class="control-label"></label>
                <input asp-for="IxlState" class="form-control" />
                <span asp-validation-for="IxlState" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IxlLicenseNo" class="control-label"></label>
                <input asp-for="IxlLicenseNo" class="form-control" />
                <span asp-validation-for="IxlLicenseNo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IxlLicenseName" class="control-label"></label>
                <input asp-for="IxlLicenseName" class="form-control" />
                <span asp-validation-for="IxlLicenseName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IxlIssueDate" class="control-label"></label>
                <input asp-for="IxlIssueDate" class="form-control" />
                <span asp-validation-for="IxlIssueDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IxlExpireDate" class="control-label"></label>
                <input asp-for="IxlExpireDate" class="form-control" />
                <span asp-validation-for="IxlExpireDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                @{
                    if (ViewData["customerKey"]?.ToString().Length > 0)
                    {
                        <input type="hidden" value="Person" name="source" id="source" />
                        <input type="hidden" value="@ViewData["customerKey"].ToString()" name="customerKey" id="customerKey" />

                    }
                    else if(ViewData["requirementKey"]?.ToString().Length > 0)
                    {
                        <input type="hidden" value="Requirement" name="source" id="source" />
                        <input type="hidden" value="@ViewData["requirementKey"].ToString()" name="requirementKey" id="requirementKey" />
                    }
                    else
                    {
                        <input type="hidden" value="License" name="source" id="source" />
                        <input type="hidden" value="" name="customerKey" id="customerKey" />
                    }
                }
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
