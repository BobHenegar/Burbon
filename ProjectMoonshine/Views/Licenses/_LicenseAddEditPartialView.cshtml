@model ProjectMoonshine.EntityFramework.Models.License

<div class="form-group">
    <label asp-for="IxlCusKey" class="control-label"></label>
    <select asp-for="IxlCusKey" class="form-control" asp-items="ViewBag.IxlCusKey"></select>
</div>
<div class="form-group">
    <label asp-for="IxlState" class="control-label"></label>
    <input asp-for="IxlState" class="form-control" />
    <span asp-validation-for="IxlState" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="IxlLicenseNo" class="control-label"></label>
    <input asp-for="IxlLicenseNo" class="form-control" />
    <span asp-validation-for="IxlLicenseNo" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="IxlLicenseName" class="control-label"></label>
    <input asp-for="IxlLicenseName" class="form-control" />
    <span asp-validation-for="IxlLicenseName" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="IxlIssueDate" class="control-label"></label>
    <input asp-for="IxlIssueDate" class="form-control" type="date"/>
    <span asp-validation-for="IxlIssueDate" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="IxlExpireDate" class="control-label"></label>
    <input asp-for="IxlExpireDate" class="form-control" type="date"/>
    <span asp-validation-for="IxlExpireDate" class="text-danger"></span>
</div>
@(await Html.PartialAsync("_RequirementDataRedirectSourcePartialView"))