@model IEnumerable<ProjectMoonshine.EntityFramework.Models.AddressType>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AdtType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdtAddDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdtModifiedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdtAddUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdtModifiedUser)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AdtType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AdtAddDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AdtModifiedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AdtAddUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AdtModifiedUser)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AdtKey">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AdtKey">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AdtKey">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
