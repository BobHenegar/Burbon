@model ProjectMoonshine.ViewModels.CredentialViewModel


<div class="form-group">
    <label asp-for="Credential.Cr1Ct1Key" class="control-label"></label>
    @Html.DropDownListFor(c => c.Credential.Cr1Ct1Key, Model.Cr1Ct1KeySelectList, "", new { @class = "form-control" })
    <span asp-validation-for="Credential.Cr1Ct1Key" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Credential.Cr1CredentialNumber" class="control-label"></label>
    <input asp-for="Credential.Cr1CredentialNumber" class="form-control" />
    <span asp-validation-for="Credential.Cr1CredentialNumber" class="text-danger"></span>
</div>
@if (ViewBag.CusKeyHasValue != null && (bool)ViewBag.CusKeyHasValue)
{
    <div class="form-group">
        <label asp-for="Credential.Cr1CusKey" class="control-label"></label>
        @Html.DropDownListFor(c => c.Credential.Cr1CusKey, Model.Cr1CusKeySelectList, "", new { @class = "form-control" })
        <span asp-validation-for="Credential.Cr1CusKey" class="text-danger"></span>
    </div>
}
else
{
    <label asp-for="Credential.Cr1CusKey" class="control-label"></label>
    @Html.DropDownListFor(c => c.Credential.Cr1CusKey, Model.Cr1CusKeySelectList, "", new { @class = "form-control", @style="readonly=true"})
    <span asp-validation-for="Credential.Cr1CusKey" class="text-danger"></span>
}
