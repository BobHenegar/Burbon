@model IEnumerable<ProjectMoonshine.EntityFramework.Models.Credential>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Cr1AddUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Cr1AddDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Cr1ChangeUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Cr1ChangeDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().CredentialType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Customer)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr1AddUser)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr1AddDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr1ChangeUser)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cr1ChangeDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CredentialType.Ct1Key)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Customer.CusKey)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Cr1Key">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Cr1Key">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Cr1Key">Delete</a>
                </td>
            </tr>
        }
    </tbody>
    @*<pager class="pager-container" list="@Model" options="@PagedListRenderOptions.TwitterBootstrapPager" asp-action="Index" asp-controller="Credentials" />*@
</table>
