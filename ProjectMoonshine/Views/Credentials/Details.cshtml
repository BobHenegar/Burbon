@model ProjectMoonshine.ViewModels.CredentialViewModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Details</h2>

<div class="row">
    <div class="col-lg-4">
        <h4>@Model.Credential.Customer.Person.PerFirstMiddleLast</h4>
        <h4>@Model.Credential.CredentialType.Ct1Description</h4>

        <hr />
        @await Html.PartialAsync("_CredentialDetailsDeletePartialView", Model)
    </div>
    <div class="col-lg-5 col-lg-offset-1">
        <h4>Current Process</h4>
        @await Html.PartialAsync("_RequirementsChecklistPartialView", Model.Credential.CurrentCredentialProcess.CredentialRequirements.OrderBy(r => r.Cr3AddDate))
    </div>
</div>

<div class="row">
    <div style="display:flex;flex-wrap:wrap;flex-direction:row;">
        @await Html.PartialAsync("_CredentialProcessesPartialView", Model.Credential.CredentialProcesses.OrderByDescending(p => p.Cr2AddDate))
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Credential.Cr1Key">Edit</a> |
        <a asp-action="Index">Back to List</a>
    </div>
</div>
