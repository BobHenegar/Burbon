@model ProjectMoonshine.ViewModels.CredentialTypeXCredentialProcessTypeViewModel


            <div class="form-group">
                <label asp-for="CredentialTypeXCredentialProcessType.Ct4Ct1Key" class="control-label"></label>
                @Html.DropDownListFor(t => t.CredentialTypeXCredentialProcessType.Ct4Ct1Key, Model.Ct4Ct1KeySelectList, new {@class="form-control"})
            </div>
            <div class="form-group">
                <label asp-for="CredentialTypeXCredentialProcessType.Ct4Ct2Key" class="control-label"></label>
                @Html.DropDownListFor(t => t.CredentialTypeXCredentialProcessType.Ct4Ct2Key, Model.Ct4Ct2KeySelectList, new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label asp-for="CredentialTypeXCredentialProcessType.Ct4StartDate" class="control-label"></label>
                <input asp-for="CredentialTypeXCredentialProcessType.Ct4StartDate" class="form-control" type="date"/>
                <span asp-validation-for="CredentialTypeXCredentialProcessType.Ct4StartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CredentialTypeXCredentialProcessType.Ct4EndDate" class="control-label"></label>
                <input asp-for="CredentialTypeXCredentialProcessType.Ct4EndDate" class="form-control" type="date"/>
                <span asp-validation-for="CredentialTypeXCredentialProcessType.Ct4EndDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CredentialTypeXCredentialProcessType.Ct4Order" class="control-label"></label>
                <input asp-for="CredentialTypeXCredentialProcessType.Ct4Order" class="form-control" type="number" min="0"/>
                <span asp-validation-for="CredentialTypeXCredentialProcessType.Ct4Order" class="text-danger"></span>
            </div>
            
