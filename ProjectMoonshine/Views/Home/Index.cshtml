@{
    ViewData["Title"] = "Home Page";
}

<div class="col-md-12">
    <div class="col-md-12" style="margin-top: 50px;">
        <div class="col-md-4 col-md-offset-2">
            <a asp-action="Index" asp-controller="People">
                <span class="glyphicon glyphicon-user" style="font-size: 100px; color: royalblue; align-self: center;"></span>
                <br/> People
            </a>
        </div>
        <div class="col-md-6">
            <a asp-action="Index" asp-controller="CredentialTypes">
                <span class="glyphicon glyphicon-wrench" style="font-size: 100px; color: royalblue; align-self: center;"></span>
                <br/> Setup
            </a>
        </div>
    </div>
    <div class="col-md-12" style="margin-top: 50px;">
        <div class="col-md-4 col-md-offset-2">
            <a asp-action="Index" asp-controller="Exams">
                <span class="glyphicon glyphicon-pencil" style="font-size: 100px; color: royalblue; align-self: center;"></span>
                <br/> Exams
            </a>
        </div>
        <div class="col-md-6">
            <a asp-action="Index" asp-controller="CommunicationTemplates">
                <span class="glyphicon glyphicon-envelope" style="font-size: 100px; color: royalblue; align-self: center;"></span>
                <br/> Communications
            </a>
        </div>
    </div>
</div>