@model IEnumerable<ProjectMoonshine.EntityFramework.Models.CredentialProcess>

@{
    ViewData["Title"] = "Home Page";
    int page;
    int.TryParse(ViewData["page"].ToString(), out page);

    page = page == null ? 1 : page;

}


    
    <div class="row" style="padding: 15px 0px 0px 0px">
        <div class="col-xs-2">
            <a asp-action="Index" asp-controller="People">
                <span class="glyphicon glyphicon-user" style="font-size: 40px; color: royalblue; align-self: center;"></span>
                <br/> People
            </a>
        </div>
        <div class="col-xs-2">
            <a asp-action="Index" asp-controller="CredentialTypes">
                <span class="glyphicon glyphicon-wrench" style="font-size: 40px; color: royalblue; align-self: center;"></span>
                <br/> Setup
            </a>
        </div>
        <div class="col-xs-2">
            <a asp-action="Index" asp-controller="Exams">
                <span class="glyphicon glyphicon-pencil" style="font-size: 40px; color: royalblue; align-self: center;"></span>
                <br/> Exams
            </a>
        </div>
        <div class="col-xs-2">
            <a asp-action="Index" asp-controller="CommunicationTemplates">
                <span class="glyphicon glyphicon-envelope" style="font-size: 40px; color: royalblue; align-self: center;"></span>
                <br/> Communications
            </a>
        </div>
    </div>
    <div class="row" style="padding: 15px 0 0 0px">
        <div class="col-xs-12">
            <ul class="nav nav-tabs">
                <li><a data-toggle="tab" href="#apps">Applications</a></li>
                <li><a data-toggle="tab" href="#recert">Renewals</a></li>

            </ul>
        </div>
    </div>


<div class="row" style="padding: 15px 0 0 0px">
    <div class="col-xs-12">
        <div class="tab-content">
            <div class=" tab-pane fade in active" id="apps">
                @await Html.PartialAsync("_CredentialProcessHomePartialView", Model.AsQueryable().Where(p => p.Cr2Ct6Key == p.CredentialProcessType.Ct2SubmittedCt6Key
                                                                                                             && p.CredentialProcessType.Ct2ProcessType == "Application")
                    .ToPagedList(page, 10))
            </div>
            <div class="tab-pane fade in" id="recert">
                @await Html.PartialAsync("_CredentialProcessHomePartialView", Model.AsQueryable().Where(p => p.CredentialProcessType.Ct2ProcessType == "Renewal")
                    .ToPagedList(page, 10))
            </div>
        </div>
    </div>
</div>

