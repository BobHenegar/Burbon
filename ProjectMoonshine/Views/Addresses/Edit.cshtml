@model ProjectMoonshine.EntityFramework.Models.Address

@{
    ViewData["Title"] = "Edit";
}

<h2>Edit</h2>

<h4>Address</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AdrKey" />
            <div class="form-group">
                <label asp-for="AdrPerKey" class="control-label"></label>
                <select asp-for="AdrPerKey" class="form-control" asp-items="ViewBag.AdrPerKey"></select>
                <span asp-validation-for="AdrPerKey" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdrCity" class="control-label"></label>
                <input asp-for="AdrCity" class="form-control" />
                <span asp-validation-for="AdrCity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdrState" class="control-label"></label>
                @Html.DropDownListFor(Model => Model.AdrState, ViewBag.StateList as SelectList, new { @class = "form-control" })
                <span asp-validation-for="AdrState" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdrZip" class="control-label"></label>
                <input asp-for="AdrZip" class="form-control" />
                <span asp-validation-for="AdrZip" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdrAddress1" class="control-label"></label>
                <input asp-for="AdrAddress1" class="form-control" />
                <span asp-validation-for="AdrAddress1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdrAddress2" class="control-label"></label>
                <input asp-for="AdrAddress2" class="form-control" />
                <span asp-validation-for="AdrAddress2" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdrAddress3" class="control-label"></label>
                <input asp-for="AdrAddress3" class="form-control" />
                <span asp-validation-for="AdrAddress3" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="AdrIsPrimaryAddress" /> @Html.DisplayNameFor(model => model.AdrIsPrimaryAddress)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="AdrIsMailingAddress" /> @Html.DisplayNameFor(model => model.AdrIsMailingAddress)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="AdrIsWorkAddress" /> @Html.DisplayNameFor(model => model.AdrIsWorkAddress)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="AdrIsHomeAddress" /> @Html.DisplayNameFor(model => model.AdrIsHomeAddress)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="AdrAddDate" class="control-label"></label>
                <input asp-for="AdrAddDate" class="form-control" />
                <span asp-validation-for="AdrAddDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdrChangeDate" class="control-label"></label>
                <input asp-for="AdrChangeDate" class="form-control" />
                <span asp-validation-for="AdrChangeDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdrAddUser" class="control-label"></label>
                <input asp-for="AdrAddUser" class="form-control" />
                <span asp-validation-for="AdrAddUser" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdrChangeUser" class="control-label"></label>
                <input asp-for="AdrChangeUser" class="form-control" />
                <span asp-validation-for="AdrChangeUser" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
            @Html.Hidden("RefAction", ViewBag.RefAction as string)
            @Html.Hidden("RefController", ViewBag.RefController as string)
            @Html.Hidden("RefId", ViewBag.RefId as string)
        </form>
    </div>
</div>

<div>
    <a asp-action="@ViewBag.RefAction" asp-route-controller="@ViewBag.RefController" asp-route-id="@ViewBag.RefId">Back</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
