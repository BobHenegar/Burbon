@model IEnumerable<ProjectMoonshine.EntityFramework.Models.Customer>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CusAddDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CusChangeDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CusAddUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CusChangeUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Person)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CusAddDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CusChangeDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CusAddUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CusChangeUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Person.PerKey)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CusKey">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CusKey">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CusKey">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
