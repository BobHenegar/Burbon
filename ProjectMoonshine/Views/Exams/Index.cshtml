@model IPagedList<ProjectMoonshine.EntityFramework.Models.Exam>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.ActionLink(@Html.DisplayNameFor(model => model.First().ExmSeatCount), "Index", new { sortOrder = "seatCount", lastOrder = ViewBag.LastSortParam, filterString = ViewBag.FilterString })
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().ExmCanRetake)
            </th>
            <th>
                @Html.ActionLink(@Html.DisplayNameFor(model => model.First().ExmAddDate), "Index", new { sortOrder = "addDate", lastOrder = ViewBag.LastSortParam, filterString = ViewBag.FilterString })
            </th>
            <th>
                @Html.ActionLink(@Html.DisplayNameFor(model => model.First().Event), "Index", new { sortOrder = "eventName", lastOrder = ViewBag.LastSortParam, filterString = ViewBag.FilterString })
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ExmSeatCount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ExmCanRetake)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ExmAddDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Event.EvtName)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ExmKey">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ExmKey">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ExmKey">Delete</a>
                </td>
            </tr>
        }
    </tbody>
    <pager class="pager-container" list="@Model" options="@PagedListRenderOptions.TwitterBootstrapPager" asp-action="Index" asp-controller="Exams" />
</table>
