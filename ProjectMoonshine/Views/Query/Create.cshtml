@model ProjectMoonshine.EntityFramework.Models.Query
@using System.Linq;
@using ProjectMoonshine.Enums;
@{
    ViewData["Title"] = "Create";
}
@section Styles {
<link rel="stylesheet" href="~/css/query-builder.css" />
}
<div class="row">
    <h2>QueryBuilder</h2>
    <form asp-action="PostCreate" id="QueryForm"></form>
    <div class="col-md-12">
        <div class="col-md-12">
            <span>From:</span>
            <label asp-for="QryName" class="control-label"></label>
            <input asp-for="QryName" type="text" />
            <span asp-validation-for="QryName" class="text-danger"></span>
        </div>
        <div class="col-md-12">
            <span>From:</span>
            <label asp-for="QryTable" class="control-label"></label>
            <select asp-for="QryTable" asp-items="ViewBag.FromTable"></select>
            <span asp-validation-for="QryTable" class="text-danger"></span>
        </div>
        <div class="col-md-12">
            <span>Where:</span>
            <div class="groups">
                <ul id="groupsHolder" class="groupQuery">
                    <div>
                        <div>
                            <button id="addRule" class="addRule">+ Rule</button>
                            <button id="addGroup" class="addGroup">+ Group</button>
                        </div>
                        <div>
                            <input value="1" name="toggle_0" type="radio" checked>
                            <label>And</label>
                            <input value="2" name="toggle_0" type="radio">
                            <label>Or</label>
                        </div>
                    </div>
                </ul>
            </div>
        </div>

        <div class="col-md-12">
            <input type="submit" value="Create" class="btn btn-default" id="CreateQuery" onclick="submitQueryForm()" />
        </div>
    </div>
</div>
</div>
 @section Scripts{
    <script>
        var subItems = @Html.Raw(ViewBag.SelectList);
        var dropdownList = [{ value: "1", text: "LessThan" },
        { value: "2", text: "GreaterThan" },
        { value: "3", text: "LessThanOrEqualsTo" },
        { value: "4", text: "GreaterThanOrEqualsTo" },
        { value: "5", text: "Equals" },
        { value: "6", text: "Contains" },
        { value: "7", text: "Like" },
        { value: "8", text: "IsNull" },
        { value: "9", text: "IsNotNull" }];

        $(document).ready(function () {
            $("#QryTable").on('change', function () {
                $("#groupsHolder").empty();
                $("#groupsHolder").html(`<div>
                        <div>
                            <button id="addRule" class="addRule">+ Rule</button>
                            <button id="addGroup" class="addGroup">+ Group</button>
                        </div>
                        <div>
                            <input value="1" name="toggle_0" type="radio" checked>
                            <label>And</label>
                            <input value="2" name="toggle_0" type="radio">
                            <label>Or</label>
                        </div>
                    </div>`);
                reRegisterDeligates();
                refreshDropDowns();
            });
            $('[id^=addGroup]').each(function () {
                $(this).off('click');
                $(this).on("click", function () {
                    $(this).closest('.groupQuery').append(createNewGroup());
                    reRegisterDeligates();
                    refreshDropDowns();
                });
            });

            $('[id^=addRule]').each(function () {
                $(this).off('click');
                $(this).on("click", function () {
                    $(this).closest('.groupQuery').append(createNewRule());
                    reRegisterDeligates();
                    refreshDropDowns();
                });
            });
            refreshDropDowns();
        });

        function refreshDropDowns() {
            var toAdd = [];
            var tableValue = $("#QryTable").val();
            if (!tableValue) {
                tableValue = "Address";
                $("#QryTable").val(tableValue);
            }
            $.each(subItems, function (index, value) {
                if (toAdd.length == 0
                    && value.table === tableValue) {
                    toAdd.push("<option data-type='" + value.type + "' value='" + value.name + "' selected>" + value.name + "</option>");
                }
                else if (value.table === tableValue) {
                    toAdd.push("<option data-type='" + value.type + "' value='" + value.name + "'>" + value.name + "</option>");
                }
            });
            $('select[id^=LeftProp]').each(function (ind, val) {
                if (val.length == 0) {
                    $(val).html(toAdd);
                }
            });
        }
        function validateBeforePost{
            $('li').each(function () {
                var leftProp = $(item).find('select#LeftProperty').find("option:selected");
                var rightProp = $(item).find('input#RightPropertyInput');
                var leftType = $(leftProp).data('type')
                var rightValue = $(rightProp).text()
                ValidateInput(leftType, rightValue);
            });
        }
