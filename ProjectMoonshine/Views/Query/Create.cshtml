@model ProjectMoonshine.EntityFramework.Models.Query
@using System.Linq;
@using ProjectMoonshine.Enums;
@{
    ViewData["Title"] = "Create";
}
@section Styles {
<link rel="stylesheet" href="~/css/query-builder.css" />
}
<div class="row">
    <h2>QueryBuilder</h2>
    <form asp-action="PostCreate" id="QueryForm"></form>
    <div class="col-md-12">
        <div class="col-md-12">
            <span>From:</span>
            <label asp-for="QryTable" class="control-label"></label>
            <select asp-for="QryTable" asp-items="ViewBag.FromTable"></select>
            <span asp-validation-for="QryTable" class="text-danger"></span>
        </div>
        <div class="col-md-12">
            <span>From:</span>
            <label asp-for="QryName" class="control-label"></label>
            <input asp-for="QryName" type="text" />
            <span asp-validation-for="QryName" class="text-danger"></span>
        </div>
        <div class="col-md-12">
            <span>Where:</span>
            <div class="groups">
                <ul id="groupsHolder" class="groupQuery">
                    <div>
                        <div>
                            <button id="addRule" class="addRule">+ Rule</button>
                            <button id="addGroup" class="addGroup">+ Group</button>
                        </div>
                        <div>
                            <input value="1" name="toggle_0" type="radio" checked>
                            <label>And</label>
                            <input value="2" name="toggle_0" type="radio">
                            <label>Or</label>
                        </div>
                    </div>
                </ul>
            </div>
        </div>

        <div class="col-md-12">
            <input type="submit" value="Create" class="btn btn-default" id="CreateQuery" onclick="submitQueryForm()" />
        </div>
    </div>
    </div>
</div>
        @section Scripts{
<script>
    var subItems = @Html.Raw(ViewBag.SelectList);
    var dropdownList = [{ value: "1", text: "LessThan" },
    { value: "2", text: "GreaterThan" },
    { value: "3", text: "LessThanOrEqualsTo" },
    { value: "4", text: "GreaterThanOrEqualsTo" },
    { value: "5", text: "Equals" },
    { value: "6", text: "Contains" },
    { value: "7", text: "Like" },
    { value: "8", text: "IsNull" },
    { value: "9", text: "IsNotNull" }];

    $(document).ready(function () {
        $("#QryTable").on('change', function () {
            $("#groupsHolder").empty();
            $("#groupsHolder").html(`<div>
                    <div>
                        <button id="addRule" class="addRule">+ Rule</button>
                        <button id="addGroup" class="addGroup">+ Group</button>
                    </div>
                    <div>
                        <input value="1" name="toggle_0" type="radio" checked>
                        <label>And</label>
                        <input value="2" name="toggle_0" type="radio">
                        <label>Or</label>
                    </div>
                </div>`);
            reRegisterDeligates();
            refreshDropDowns();
        });
        $('[id^=addGroup]').each(function () {
            $(this).off('click');
            $(this).on("click", function () {
                $(this).closest('.groupQuery').append(createNewGroup());
                reRegisterDeligates();
                refreshDropDowns();
            });
        });

        $('[id^=addRule]').each(function () {
            $(this).off('click');
            $(this).on("click", function () {
                $(this).closest('.groupQuery').append(createNewRule());
                reRegisterDeligates();
                refreshDropDowns();
            });
        });
        refreshDropDowns();
    });
    function reRegisterDeligates() {
        var addRule = $("[id=addRule]").attr("id", function (i) {
            return "addRule_" + i;
        });
        var addGroup = $("[id=addGroup]").attr("id", function (i) {
            return "addGroup_" + i;
        });
        var removeGroup = $('[id^=removeGroup]').attr("id", function (i) {
            return "removeGroup_" + i;
        });
        var removeRule = $('[id^=removeRule]').attr("id", function (i) {
            return "removeRule_" + i;
        });

        $.each(addRule, function (id, pos) {
            $("#" + id).css(pos);
        });
        $.each(addGroup, function (id, pos) {
            $("#" + id).css(pos);
        });
        $.each(removeGroup, function (id, pos) {
            $("#" + id).css(pos);
        });
        $.each(removeRule, function (id, pos) {
            $("#" + id).css(pos);
        });

        $('[id^=removeRule]').each(function () {
            $(this).off('click');
            $(this).on("click", function () {
                $(this).closest('.ruleQuery').remove();
                refreshDropDowns();
                reRegisterDeligates();
            });
        });
        $('[id^=removeGroup]').each(function () {
            $(this).off('click');
            $(this).on("click", function () {
                $(this).closest('.groupQuery').remove();
                refreshDropDowns();
                reRegisterDeligates();
            });
        });

        $('[id^=addGroup]').each(function () {
            $(this).off('click');
            $(this).on("click", function () {

                $(this).closest('.groupQuery').append(createNewGroup());
                refreshDropDowns();
                reRegisterDeligates();
            });
        });

        $('[id^=addRule]').each(function () {
            $(this).off('click');
            $(this).on("click", function () {
                $(this).closest('.groupQuery').append(createNewRule());
                refreshDropDowns();
                reRegisterDeligates();
            });
        });
        refreshDropDowns();
    }

    function createNewGroup() {
        var id = $('ul[class^=groupQuery]').length;
        var result =
            `<ul class="groupQuery">
            <div class="menuBar">
                <div>
                    <button class="removeGroup" id="removeGroup">- Delete</button>
                    <button class="addRule" id="addRule">+ Rule</button>
                    <button class="addGroup" id="addGroup">+ Group</button>
                </div >
                <div>
                    <input value="1" name="toggle_`+ id + `" type="radio" checked>
                    <label>And</label>
                    <input value="2" name="toggle_`+ id + `" type="radio">
                    <label>Or</label>
                </div>
            </div>
        </ul>`;
        return result;
    }

    function createNewRule() {
        var result =
            `<li class="ruleQuery">
                <div class="flexRow">
                    <div class="ruleInput">
                        <select id="LeftProperty"></select>
                    </div>
                    <div class="equalityComparisonSelect ruleInput" >
                       @Html.DropDownList("EqualityComparison", new SelectList(ViewBag.EqualityComparisonsList, "Key", "Value", "4"), null, new { id = "EqualityComparison", })
                    </div>
                    <div class="ruleInput">
                        <input id="RightProperty" type="text" class="ruleInputright"></input>
                    </div>
                    <div  class="ruleInput">
                        <button class="removeRule" id="removeRule">- Delete</button>
                    </div>
                </div>
            </li>`;
        return result;
    }

    function submitQueryForm() {
        var xhr = new XMLHttpRequest();
        xhr.open('POST', 'Create', true);
        xhr.setRequestHeader('Content-Type', 'application/json; charset=UTF-8');
        xhr.onload = function () {
            if (xhr.status === 200) {
                window.location = xhr.responseURL;
            }
        };

        var holder = $('#groupsHolder');
        var items = holder.children('ul.groupQuery, li.ruleQuery');
        var result = mapRecursively(items);
        console.log(JSON.stringify(result));
        xhr.send(JSON.stringify(result))
    }

    function mapRecursively(itemList) {
        var logic = $('input[name^="toggle_"]:checked').val();
        var base = $('#QryTable').val();
        var name = $('#QryName').val();
        var result = {
            queryName: name,
            baseType: base,
            logic: logic,
            logicList: searchObject(itemList, logic)
        };
        return result;
    }

    function searchObject(list, logic) {
        var res = { logicGroup: [], logic: logic };
        $(list).map(function (index, item) {
            var nodeName = $(item).prop('nodeName');
            if (nodeName === "LI") {
                var leftProp = $(item).find('select#LeftProperty').find("option:selected");
                var rightProp = $(item).find('input#RightProperty');
                var logic = $(item).find('#EqualityComparison').find('option:selected');
                res.logicGroup.push({
                    lhs: { type: $(leftProp).data('type'), value: $(leftProp).val() },
                    logic: logic.val(),
                    rhs: $(rightProp).text() === "" ? $(rightProp).val() : $(rightProp).text()
                });
            }
            else if (nodeName === "UL") {
                res.logicGroup.push(searchObject($(item).children('ul.groupQuery, li.ruleQuery'), $(item).find('input[name^="toggle_"]:checked').val()));
            }
        });
        return res;
    }

    function refreshDropDowns() {
        var toAdd = [];
        var tableValue = $("#QryTable").val();
        if (!tableValue) {
            tableValue = "Address";
            $("#QryTable").val(tableValue);
        }
        $.each(subItems, function (index, value) {
            if (toAdd.length == 0
                && value.table === tableValue) {
                toAdd.push("<option data-type='" + value.type + "' value='" + value.name + "' selected>" + value.name + "</option>");
            }
            else if (value.table === tableValue) {
                toAdd.push("<option data-type='" + value.type + "' value='" + value.name + "'>" + value.name + "</option>");
            }
        });
        $('select[id^=LeftProp]').each(function (ind, val) {
            if (val.length == 0) {
                $(val).html(toAdd);
            }
        });
    }
</script>
        }

