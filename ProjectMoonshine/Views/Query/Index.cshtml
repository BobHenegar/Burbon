@section Scripts{
    <script>
        var subItems = @Html.Raw(ViewBag.SelectList);
        $(document).ready(function () {
            $('[id^=removeRule]').each(function () {
                $(this).off('click');
                $(this).on("click", function () {
                    $(this).closest('.ruleQuery').remove();
                    reRegisterDeligates();
                });
            });

            $('[id^=addGroup]').each(function () {
                $(this).off('click');
                $(this).on("click", function () {
                    $(this).closest('.groupQuery').append(createNewGroup());
                    reRegisterDeligates();
                });
            });

            $('[id^=addRule]').each(function () {
                $(this).off('click');
                $(this).on("click", function () {
                    $(this).closest('.groupQuery').append(createNewRule());
                    reRegisterDeligates();
                });
            });
        });
        function reRegisterDeligates() {
            var addRule = $("[id=addRule]").attr("id", function (i) {
                return "addRule_" + i;
            });
            var addGroup = $("[id=addGroup]").attr("id", function (i) {
                return "addGroup_" + i;
            });
            var removeGroup = $('[id^=removeGroup]').attr("id", function (i) {
                return "removeGroup_" + i;
            });
            var removeRule = $('[id^=removeRule]').attr("id", function (i) {
                return "removeRule_" + i;
            });

            $.each(addRule, function (id, pos) {
                $("#" + id).css(pos);
            });
            $.each(addGroup, function (id, pos) {
                $("#" + id).css(pos);
            });
            $.each(removeGroup, function (id, pos) {
                $("#" + id).css(pos);
            });
            $.each(removeRule, function (id, pos) {
                $("#" + id).css(pos);
            });

            $('[id^=removeGroup]').each(function () {
                $(this).off('click');
                $(this).on("click", function () {
                    $(this).closest('ul').remove();
                    reRegisterDeligates();
                });
            });
            $('[id^=removeRule]').each(function () {
                $(this).off('click');
                $(this).on("click", function () {
                    console.log($(this).closest('.ruleQuery').remove());
                    reRegisterDeligates();
                });
            });
            $('[id^=addGroup]').each(function () {
                $(this).off('click');
                $(this).on("click", function () {
                    $(this).closest('.groupQuery').append(createNewGroup());
                    reRegisterDeligates();
                });
            });
            $('[id^=addRule]').each(function () {
                $(this).off('click');
                $(this).on("click", function () {
                    $(this).closest('.groupQuery').append(createNewRule());
                    refreshDropDowns();
                    reRegisterDeligates();
                });
            });
            refreshDropDowns();
        }
        function createNewGroup() {
            var id = $('ul[class^=groupQuery]').length;
            var result =
            `<ul class="groupQuery">
                <div class="menuBar">
                    <div>
                        <button class="removeGroup" id="removeGroup">- Delete</button>
                        <button class="addRule" id="addRule">+ Rule</button>
                        <button class="addGroup" id="addGroup">+ Group</button>
                    </div >
                    <div>
                        <input value="1" name="toggle_`+ id + `" type="radio" checked>
                        <label>And</label>
                        <input value="2" name="toggle_`+ id + `" type="radio">
                        <label>Or</label>
                    </div>
                </div>
            </ul>`;
            return result;
        }

        function createNewRule() {
            var result =
                `<li class="ruleQuery">
                <div class="flexRow">
                    <div class="ruleInput">
                        <select id="LeftProperty"></select>
                    </div>
                    <div class="equalityComparisonSelect ruleInput" >
                        <select id="EqualityComparison">
                            <option value="1">LessThen</option>
                            <option value="2">GreaterThen</option>
                            <option value="3">LessThenOrEqualsTo</option>
                            <option value="4">GreaterThenOrEqualsTo</option>
                            <option value="5">Equals</option>
                        </select>
                    </div>
                    <div class="ruleInput">
                        <input id="RightProperty" type="text" class="ruleInputright"></input>
                    </div>
                    <div  class="ruleInput">
                        <button class="removeRule" id="removeRule">- Delete</button>
                    </div>
                </div>
            </li>`;
            return result;
        }

        function submitQueryForm() {
            var xhr = new XMLHttpRequest();
            xhr.open('POST', 'Query/Create', true);
            xhr.setRequestHeader('Content-Type', 'application/json; charset=UTF-8');

            var holder = $('#groupsHolder');
            var items = holder.children('ul.groupQuery, li.ruleQuery');
            var result = mapRecursively(items);
            xhr.send(JSON.stringify(result));
        }

        function mapRecursively(itemList) {
            var logic = $('input[name^="toggle_"]:checked').val();
            var base = $('#TableSelectList').find(':selected').text();
            var includes = [];
            //$('').each(function (index, value) {
            //    includes.push(value);
            //};
            var result = {
                baseType: base,
                includes: [],
                logic: logic,
                logicList: searchObject(itemList, logic)
            };
            return result;
        }

        function searchObject(list, logic) {
            var res = { logicGroup: [], logic: logic };
            $(list).map(function (index, item) {
                var nodeName = $(item).prop('nodeName');
                if (nodeName === "LI") {
                    var leftProp = $(item).find('select#LeftProperty').find("option:selected");
                    var rightProp = $(item).find('input#RightProperty');
                    res.logicGroup.push({
                        lhs: { type: $(leftProp).data('type'), value: $(leftProp).val() },
                        logic: $(item).find('#EqualityComparison').find(":selected").val(),
                        rhs: $(rightProp).text() === "" ? $(rightProp).val() : $(rightProp).text()
                    });
                }
                else if (nodeName === "UL") {
                    res.logicGroup.push(searchObject($(item).children('ul.groupQuery, li.ruleQuery'), $(item).find('input[name^="toggle_"]:checked').val()));
                }
            });
            return res;
        }
        function refreshDropDowns() {
            var toAdd = [];
            var tableValue = $("#TableSelectList").val();
            if (!tableValue) {
                tableValue = "Address";
                $("#TableSelectList").val(tableValue);
            }
            $.each(subItems, function (index, value) {
                if (index == 0) {
                    toAdd.push("<option data-type='" + value.type + "' value='" + value.name + "' selected>" + value.name + "</option>");
                }
                else if (value.table === tableValue) {
                    toAdd.push("<option data-type='" + value.type + "' value='" + value.name + "'>" + value.name + "</option>");
                }
            });
            $('select[id^=LeftProp]').each(function (ind, val) {
                if (val.length == 0) {
                    $(val).html(toAdd);
                }
            });
        }
    </script>
}

