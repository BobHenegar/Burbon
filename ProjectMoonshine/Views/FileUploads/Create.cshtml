@model ProjectMoonshine.ViewModels.FileUploadViewModel

@{
    ViewData["Title"] = "Create";
}
<style>
    #dropZone {
        background: gray;
        border: black dashed 3px;
        width: 200px;
        padding: 50px;
        text-align: center;
        color: white;
    }
</style>
<h2>Create</h2>

<h4>FileUpload</h4>
<hr />
<div class="row">
    <form method="post" enctype="multipart/form-data" asp-controller="FileUploads" asp-action="Create">
        <div class="col-md-12">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-md-12">
                <div class="form-group">
                    <label asp-for="FupFileDescription" class="control-label"></label>
                    <textarea asp-for="FupFileDescription" class="form-control" style="width:45%;height:150px;text-align:left;"></textarea>
                    <span asp-validation-for="FupFileDescription" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <div class="col-md-6">
                        <input type="file" name="file" />
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-default" />
                </div>
            </div>
        </div>
    </form>
    <div>
        <a asp-action="People" asp-controller="FileUploads" asp-route-id="@ViewBag.PerKey">Back to Profile</a>
    </div>
</div>

@section Scripts{
}
