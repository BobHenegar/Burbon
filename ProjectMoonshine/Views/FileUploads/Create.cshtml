@model ProjectMoonshine.ViewModels.FileUploadViewModel

@{
    ViewData["Title"] = "Create";
}
<style>
    #dropZone {
        background: gray;
        border: black dashed 3px;
        width: 200px;
        padding: 50px;
        text-align: center;
        color: white;
    }
</style>
<h2>Create</h2>

<h4>FileUpload</h4>
<hr />
<div class="row">
    <form method="post" enctype="multipart/form-data" asp-controller="FileUploads" asp-action="Create">
        <div class="col-md-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="FupFileDescription" class="control-label"></label>
                <textarea asp-for="FupFileDescription" class="form-control" rows="3"></textarea>
                <span asp-validation-for="FupFileDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FupDtpKey" class="control-label"></label>
                @Html.DropDownListFor(f => f.FupDtpKey, (SelectList)ViewBag.FupDtpKey, "", new { @class = "form-control" })
                <span asp-validation-for="FupDtpKey" class="text-danger"></span>
            </div>

            <div class="form-group">

                <input type="file" name="file" />

            </div>


            @(await Html.PartialAsync("_RequirementDataRedirectSourcePartialView"))

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </form>

</div>    
<div class="row">
    <div class="col-md-4">
        @if (@ViewData["requirementKey"]?.ToString().Length > 0)
        {
            <a asp-action="GoBack" asp-route-requirementKey="@ViewData["requirementKey"]">Back to Requirement</a>
        }
        else
        {
            <a asp-action="People" asp-controller="FileUploads" asp-route-id="@ViewBag.PerKey">Back to Profile</a>
        }
    </div>
    
</div>

@section Scripts{
}
