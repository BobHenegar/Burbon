@model IEnumerable<ProjectMoonshine.EntityFramework.Models.FileUpload>

@{
    ViewData["Title"] = "Index";
}

<h4>File Uploads</h4>

<p>
    <a asp-action="Create" asp-route-id="@ViewBag.PerKey">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FupFileName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FupFileType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FupFileDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Person)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a href="~/FileUploads/View/@item.FupKey" target=_blank>@Html.DisplayFor(model => item.FupFileName)</a>
                </td>
                <td>
                    @Html.ValueFor(model => item.FupFileType)
                </td>
                <td>
                    @Html.DisplayFor(model => item.FupFileDescription)
                </td>
                <td>
                    <a asp-action="Details" asp-controller="People" asp-route-id="@item.FupPerKey">@Html.DisplayFor(model => item.Person.PerFirstMiddleLast)</a>
                </td>
                <td>
                    <a asp-action="Delete" asp-controller="FileUploads" asp-route-id="@item.FupKey">Delete @Html.DisplayFor(model => item.FupFileName)</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Details" asp-controller="People" asp-route-id="@ViewBag.PerKey">Back To Profile</a>
