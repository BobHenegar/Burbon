@using GlobalConstants = ProjectMoonshine.EntityFramework.GlobalConstants
@model ProjectMoonshine.EntityFramework.Models.CredentialRequirementTemplate

            
            <div class="form-group">
                <label asp-for="Ct8Template" class="control-label"></label>
                <input asp-for="Ct8Template" class="form-control" />
                <span asp-validation-for="Ct8Template" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ct8Code" class="control-label"></label>
                @Html.DropDownListFor(t => t.Ct8Code, Html.GetEnumSelectList<GlobalConstants.RequirementTemplateCode>(), new { @class = "form-control"})
                @*<select asp-for="Ct8Code" class="form-control"></select>*@
                <span asp-validation-for="Ct8Code" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ct8Description" class="control-label"></label>
                <input asp-for="Ct8Description" class="form-control" />
                <span asp-validation-for="Ct8Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="Ct8SetDataKeyFlag" /> @Html.DisplayNameFor(model => model.Ct8SetDataKeyFlag)
                    </label>
                </div>
            </div>